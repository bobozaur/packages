#!/bin/sh /etc/rc.common
# Copyright (C) 2015 OpenWrt.org

START=60
USE_PROCD=1

BIN=/usr/sbin/pptpd
CONFIG=/var/etc/pptpd.conf
RUN_D=/var/etc/pptpd
CHAP_SECRETS=$RUN_D/chap-secrets
OPTIONS_PPTP=/var/etc/options.pptpd

pptpd_mppe_options() {
	local option required no40 no128 stateful

	for option in $(printf '%s' "$1" | tr ',' ' '); do
		case "$option" in
			required) required=1 ;;
			no40) no40=1 ;;
			no56) ;; # pppd does not support 56-bit MPPE.
			no128) no128=1 ;;
			stateless) stateful=nomppe-stateful ;;
			stateful) stateful=mppe-stateful ;;
			*) echo "pptpd: unsupported MPPE option '$option'" >&2; return 1 ;;
		esac
	done

	[ -n "$required" ] || {
		echo "pptpd: pppd requires MPPE to be mandatory" >&2
		return 1
	}
	[ -z "$no40" ] || [ -z "$no128" ] || {
		echo "pptpd: no supported MPPE key length remains" >&2
		return 1
	}

	# Apply exclusions after enabling MPPE, regardless of UCI list order.
	echo require-mppe
	[ -z "$no40" ] || echo nomppe-40
	[ -z "$no128" ] || echo nomppe-128
	[ -z "$stateful" ] || echo "$stateful"
}

validate_login_section() {
	uci_load_validate pptpd login "$1" "$2" \
		'username:string' \
		'password:string' \
		'remoteip:string'
}

validate_pptpd_section() {
	uci_load_validate pptpd service "$1" "$2" \
		'enabled:bool:1' \
		'localip:string' \
		'remoteip:string' \
		'mppe:list(string):required no40 no56 stateless' \
		'logwtmp:bool:0'
}

setup_config() {
	[ "$2" = 0 ] || {
		echo "validation failed"
		return 1
	}

	[ "$enabled" -eq 0 ] && return 1

	mkdir -p /var/etc
	cp /etc/pptpd.conf "$next_config" || return 1
	cp /etc/ppp/options.pptpd "$next_options" || return 1

	[ -n "$localip" ] && echo "localip  $localip" >> "$next_config"
	[ -n "$remoteip" ] && echo "remoteip  $remoteip" >> "$next_config"
	[ "$logwtmp" -eq 1 ] && echo "logwtmp" >> "$next_config"

	pptpd_mppe_options "$mppe" >> "$next_options" || return 1
	printf 'chap-secrets "%s"\n' "$CHAP_SECRETS" >> "$next_options"

	return 0
}

start_service() {
	local enabled stage next_config next_options
	config_load pptpd
	config_get_bool enabled pptpd enabled 1
	[ "$enabled" = 1 ] || return
	umask 077
	mkdir -p "$RUN_D" || exit 1
	chmod 0700 "$RUN_D" || exit 1
	stage="$(mktemp -d "$RUN_D/config.XXXXXX")" || exit 1
	next_config="$stage/pptpd.conf"
	next_options="$stage/options.pptpd"
	ucode /usr/share/pptpd/credentials.uc "$stage" &&
		validate_pptpd_section pptpd setup_config || {
		rm -rf "$stage"
		exit 1
	}
	mv -f "$stage/chap-secrets" "$CHAP_SECRETS" &&
		mv -f "$next_options" "$OPTIONS_PPTP" &&
		mv -f "$next_config" "$CONFIG" || {
		rm -rf "$stage"
		exit 1
	}
	rmdir "$stage"

	procd_open_instance
	procd_set_param command $BIN -c $CONFIG --fg -o $OPTIONS_PPTP -p /var/run/pptpd.pid
	procd_set_param file "$CONFIG" "$OPTIONS_PPTP" "$CHAP_SECRETS"
	procd_set_param term_timeout 15
	procd_set_param respawn
	procd_close_instance
}

service_triggers () {
	procd_add_reload_trigger "pptpd"

	procd_open_validate
	validate_pptpd_section
	validate_login_section
	procd_close_validate
}
