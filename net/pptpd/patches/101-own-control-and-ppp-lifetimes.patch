+static void stop_controllers(void)
+{
+        struct controller *entry;
+        int i, status;
+
+        sigchld_responder(SIGCHLD);
+#ifdef BCRELAY
+        if (bcrelayfork > 0)
+                kill(bcrelayfork, SIGTERM);
+#endif
+        for (entry = controllers; entry; entry = entry->next)
+                kill(entry->pid, SIGTERM);
+
+        /* Each controller first retires its PPP child, then closes control.
+         * Bound unresponsive control peers before the manager can restart.
+         */
+        for (i = 0; i < 100; i++) {
+                if (!controllers
+#ifdef BCRELAY
+                    && !bcrelayfork
+#endif
+                   )
+                        break;
+                usleep(100000);
+                sigchld_responder(SIGCHLD);
+        }
+        for (entry = controllers; entry; entry = entry->next)
+                kill(entry->pid, SIGKILL);
+#ifdef BCRELAY
+        if (bcrelayfork > 0)
+                kill(bcrelayfork, SIGKILL);
+#endif
+        /* As subreaper, include PPP and scripts adopted from a forced exit.
+         * If procd's deadline expires, the inherited instance lock still
+         * prevents a replacement from accepting clients before they finish.
+         */
+        while (waitpid(-1, &status, 0) >= 0 || errno == EINTR)
+                ;
+        while ((entry = controllers)) {
+                controllers = entry->next;
+                free(entry);
+        }
+}
