+/* The open file description is inherited by controllers, PPP and its scripts.
+ * A forced parent exit must not let a new manager reuse their addresses.
+ */
+static int lock_instance(const char *pid_file)
+{
+        char *path;
+        int fd, i;
+
+        path = malloc(strlen(pid_file) + sizeof(".lock"));
+        if (!path)
+                return -1;
+        sprintf(path, "%s.lock", pid_file);
+        fd = open(path, O_RDWR | O_CREAT, 0600);
+        free(path);
+        if (fd < 0)
+                return -1;
+
+        for (i = 0; i < 100; i++) {
+                if (!flock(fd, LOCK_EX | LOCK_NB))
+                        return 0;
+                if (errno != EWOULDBLOCK && errno != EINTR)
+                        break;
+                usleep(100000);
+        }
+        close(fd);
+        return -1;
+}
 
