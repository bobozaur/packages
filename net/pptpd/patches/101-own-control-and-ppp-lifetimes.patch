+/* Reap the exact PPP owner before a controller or its address slot is released. */
+static void stop_pppd(void)
+{
+        int i, status;
+        pid_t result;
+
+        if (pppfork <= 0)
+                return;
+        result = waitpid(pppfork, &status, WNOHANG);
+        if (result == pppfork || (result < 0 && errno == ECHILD))
+                goto done;
+
+        kill(pppfork, SIGTERM);
+        for (i = 0; i < 30; i++) {
+                result = waitpid(pppfork, &status, WNOHANG);
+                if (result == pppfork || (result < 0 && errno == ECHILD))
+                        goto done;
+                usleep(100000);
+        }
+        kill(pppfork, SIGKILL);
+        while (waitpid(pppfork, &status, 0) < 0 && errno == EINTR)
+                ;
+done:
+        /* pppd can time out waiting for down scripts or be killed above.
+         * As their subreaper, retain this call's slot until they also exit.
+         */
+        while (waitpid(-1, &status, 0) >= 0 || errno == EINTR)
+                ;
+        pppfork = 0;
+}
