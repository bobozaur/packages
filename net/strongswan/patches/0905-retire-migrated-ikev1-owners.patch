From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] Retire migrated IKEv1 owners during the delayed delete grace period

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
--- a/src/libcharon/processing/jobs/adopt_children_job.c
+++ b/src/libcharon/processing/jobs/adopt_children_job.c
@@ -176,6 +176,9 @@
 					}
 					else
 					{
+						/* Keep DELETE usable, but retire the migrated owner from
+						 * local renewal, DPD and new Quick Mode requests. */
+						ike_sa->set_state(ike_sa, IKE_REKEYING);
 						lib->scheduler->schedule_job(lib->scheduler, (job_t*)
 								delete_ike_sa_job_create(ike_sa->get_id(ike_sa),
 														 TRUE), 10);
--- a/src/libcharon/sa/ike_sa_manager.c
+++ b/src/libcharon/sa/ike_sa_manager.c
@@ -1579,6 +1579,8 @@
 		}
 		if (entry->ike_sa->get_state(entry->ike_sa) == IKE_DELETING ||
 			entry->ike_sa->get_state(entry->ike_sa) == IKE_REKEYED ||
+			(entry->ike_sa->get_version(entry->ike_sa) == IKEV1 &&
+			 entry->ike_sa->get_state(entry->ike_sa) == IKE_REKEYING) ||
 			entry->ike_sa->has_condition(entry->ike_sa, COND_REDIRECTED) ||
 			ike_sa_is_delete_queued(entry->ike_sa))
 		{	/* skip IKE_SAs which are not usable, wake other waiting threads */
@@ -2220,6 +2222,7 @@
 			/* IKEv1 implicitly takes over children, IKEv2 recreates them
 			 * explicitly. */
 			adopt_children_and_vips(duplicate, new);
+			duplicate->set_state(duplicate, IKE_REKEYING);
 		}
 		/* For IKEv1 we have to delay the delete for the old IKE_SA. Some
 		 * peers need to complete the new SA first, otherwise the quick modes
--- a/src/libcharon/sa/ike_sa.c
+++ b/src/libcharon/sa/ike_sa.c
@@ -1987,6 +1987,7 @@
 	private_ike_sa_t *this)
 {
 	if (this->state == IKE_PASSIVE ||
+		(this->version == IKEV1 && this->state != IKE_ESTABLISHED) ||
 		has_condition(this, COND_REAUTHENTICATING))
 	{
 		return INVALID_STATE;
@@ -2015,7 +2016,9 @@
 METHOD(ike_sa_t, reauth, status_t,
 	private_ike_sa_t *this)
 {
-	if (this->state == IKE_PASSIVE)
+	if (this->state == IKE_PASSIVE ||
+		(this->version == IKEV1 && this->state != IKE_ESTABLISHED &&
+		 this->state != IKE_CONNECTING))
 	{
 		return INVALID_STATE;
 	}
