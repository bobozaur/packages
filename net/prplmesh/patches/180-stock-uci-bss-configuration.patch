+#ifdef PRPLMESH_STOCK_OPENWRT_UCI
+bool ap_wlan_hal_nl80211::get_vap_status(
+    const std::list<son::wireless_utils::sBssInfoConf> &bss_info_conf_list)
+{
+    if (m_expected_config_ids.empty()) {
+        return bss_info_conf_list.empty();
+    }
+    for (const auto &expected : m_expected_config_ids) {
+        if (add_interface(expected.first) < 0) {
+            return false;
+        }
+        parsed_obj_map_t config;
+        if (!wpa_ctrl_send_msg("GET_CONFIG", config, expected.first)) {
+            return false;
+        }
+        for (const auto &value : expected.second) {
+            auto actual = config[value.first];
+            auto wanted = value.second;
+            if (value.first == "key_mgmt" || value.first == "rsn_pairwise_cipher") {
+                auto words = [](const std::string &text) {
+                    std::istringstream input(text);
+                    std::set<std::string> result;
+                    std::string word;
+                    while (input >> word) result.insert(word);
+                    return result;
+                };
+                if (words(actual) == words(wanted)) continue;
+            } else if (actual == wanted) {
+                continue;
+            }
+            // Never include values: credential comparisons use this path too.
+            LOG(DEBUG) << "Native BSS configuration pending: " << expected.first
+                       << ", field " << value.first;
+            return false;
+        }
+    }
+    return refresh_vaps_info(beerocks::IFACE_RADIO_ID);
+}
+#endif
 
