+#ifdef PRPLMESH_STOCK_OPENWRT_UCI
+bool ApManager::sync_ext_events_handlers()
+{
+    // Polling can attach newly configured BSSs or retire old ones. Rebind
+    // every descriptor at this event-loop boundary, including numeric fd reuse.
+    for (auto fd : m_ap_hal_ext_events) {
+        if (fd > 0) {
+            m_event_loop->remove_handlers(fd);
+        }
+    }
+    m_ap_hal_ext_events = ap_wlan_hal->get_ext_events_fds();
+    for (auto fd : m_ap_hal_ext_events) {
+        if (fd > 0 && !register_ext_events_handlers(fd)) {
+            return false;
+        }
+    }
+    return true;
+}
+#endif
 
