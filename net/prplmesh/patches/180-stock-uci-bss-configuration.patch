+bool bpl_cfg_apply_wifi_configuration(
+    const std::string &radio_iface,
+    const std::unordered_map<std::string, std::string> &bss_ifnames,
+    const std::list<son::wireless_utils::sBssInfoConf> &configuration,
+    const std::string &backhaul_ssid, const std::string &backhaul_key,
+    std::unordered_map<std::string, std::unordered_map<std::string, std::string>> &expected_config_ids)
+{
+    expected_config_ids.clear();
+    if (std::any_of(backhaul_key.begin(), backhaul_key.end(),
+                    [](unsigned char c) { return c < 0x20 || c == 0x7f; })) {
+        return false;
+    }
+    std::string primary_section;
+    WirelessTransaction transaction;
+    Sections current;
+    if (!transaction.open() || !transaction.read(current) ||
+        !primary_ap(current, radio_iface, primary_section)) {
+        return false;
+    }
+    auto primary = current.find(primary_section);
+    if (primary == current.end() || text(primary->second, ".type") != "wifi-iface" ||
+        text(primary->second, "mode") != "ap" ||
+        text(primary->second, "ifname") != radio_iface) {
+        return false;
+    }
+    const auto device = text(primary->second, "device");
+    if (device.empty() || !current.count(device) ||
+        text(current.at(device), ".type") != "wifi-device") {
+        return false;
+    }
+
+    transaction.bind(primary_section);
+    Sections updates;
+    std::set<std::string> used;
+    std::set<std::string> new_sections;
+    std::map<std::string, std::vector<std::string>> removals;
+    std::set<std::string> reserved_ifnames;
+    for (const auto &bss : configuration) {
+        auto named = bss_ifnames.find(tlvf::mac_to_string(bss.bssid));
+        if (named != bss_ifnames.end()) reserved_ifnames.insert(named->second);
+    }
+    for (const auto &bss : configuration) {
+        std::string section;
+        auto iface = bss_ifnames.find(tlvf::mac_to_string(bss.bssid));
+        if (iface != bss_ifnames.end()) {
+            if (iface->second == radio_iface) {
+                section = primary_section;
+            } else {
+                for (const auto &candidate : current) {
+                    if (text(candidate.second, "ifname") == iface->second) {
+                        section = candidate.first;
+                        break;
+                    }
+                }
+            }
+        } else if (tlvf::mac_to_string(bss.bssid) == net::network_utils::WILD_MAC_STRING) {
+            // Reconcile a committed new BSS before allocating another. Exact
+            // requested semantics and one-use-per-request preserve multiplicity,
+            // including two distinct APs with the same SSID and credentials.
+            for (const auto &candidate : current) {
+                if (candidate.first.rfind("prplmesh_" + primary_section + "_", 0) == 0 &&
+                    text(candidate.second, ".type") == "wifi-iface" &&
+                    text(candidate.second, "mode") == "ap" &&
+                    text(candidate.second, "device") == device &&
+                    !enabled(candidate.second, "disabled") &&
+                    !used.count(candidate.first) &&
+                    !reserved_ifnames.count(text(candidate.second, "ifname")) &&
+                    matches_owned_bss(candidate.second, primary->second, current.at(device),
+                                      bss, backhaul_ssid, backhaul_key)) {
+                    section = candidate.first;
+                    break;
+                }
+            }
+            // A disabled BSS remains an owned, reusable slot after teardown.
+            for (const auto &candidate : current) {
+                if (section.empty() &&
+                    text(candidate.second, ".type") == "wifi-iface" &&
+                    text(candidate.second, "mode") == "ap" &&
+                    text(candidate.second, "device") == device &&
+                    text(candidate.second, "start_disabled") == "1" &&
+                    text(candidate.second, "disabled") != "1" &&
+                    text(candidate.second, "disabled") != "true" &&
+                    (candidate.first == primary_section ||
+                     candidate.first.rfind("prplmesh_" + primary_section + "_", 0) == 0) &&
+                    !used.count(candidate.first) &&
+                    !reserved_ifnames.count(text(candidate.second, "ifname"))) {
+                    section = candidate.first;
+                    break;
+                }
+            }
+            if (section.empty() && !bss.teardown) {
+                for (int id = IFACE_VAP_ID_MIN; id <= IFACE_VAP_ID_MAX; ++id) {
+                    const auto ifname = utils::get_iface_string_from_iface_vap_ids(radio_iface, id);
+                    const auto name = "prplmesh_" + primary_section + "_" + std::to_string(id);
+                    const bool taken = std::any_of(
+                        current.begin(), current.end(), [&](const Sections::value_type &entry) {
+                            return text(entry.second, "ifname") == ifname;
+                        });
+                    if (ifname.empty() || ifname == radio_iface || taken || current.count(name) || new_sections.count(name)) {
+                        continue;
+                    }
+                    section = name;
+                    auto &options = updates[section];
+                    options["device"] = Value(device);
+                    options["mode"] = Value("ap");
+                    options["ifname"] = Value(ifname);
+                    if (primary->second.count("network")) {
+                        options["network"] = primary->second.at("network");
+                    }
+                    new_sections.insert(section);
+                    break;
+                }
+            }
+        }
+        if (section.empty() || !used.insert(section).second) {
+            LOG(ERROR) << "Cannot bind Controller BSS to an owned OpenWrt AP section";
+            return false;
+        }
+        if (!new_sections.count(section) &&
+            (text(current.at(section), "device") != device ||
+             text(current.at(section), "mode") != "ap")) {
+            return false;
+        }
+
+        auto &values = updates[section];
+        if (!credentials(bss, values) ||
+            !native_security_policy(current.count(section) ? current.at(section) : Options{},
+                                    current.at(device), values)) {
+            return false;
+        }
+        if (!bss.teardown) {
+            removals[section] = credential_overrides;
+            if (text(values, "encryption") == "none") {
+                removals[section].push_back("key");
+            }
+            values["multi_ap_backhaul_ssid"] = Value(bss.fronthaul ? backhaul_ssid : "");
+            values["multi_ap_backhaul_key"] = Value(bss.fronthaul ? backhaul_key : "");
+
+        }
+        Value raw = unrelated_options(current.count(section) ? current.at(section) : Options{});
+        raw.strings.emplace_back("notify_mgmt_frames=1");
+        if (!bss.teardown) {
+            raw.strings.emplace_back("multi_ap_client_disallow=" +
+                std::to_string((bss.profile1_backhaul_sta_association_disallowed ? 1 : 0) |
+                               (bss.profile2_backhaul_sta_association_disallowed ? 2 : 0)));
+        }
+        values["hostapd_bss_options"] = raw;
+
+        // hostapd exposes config_id through GET_CONFIG. Tie completion to
+        // the loaded native BSS configuration, including same-SSID rekeys.
+        Options desired = current.count(section) ? current.at(section) : Options{};
+        for (const auto &value : values) {
+            desired[value.first] = value.second;
+        }
+        for (const auto &name : removals[section]) {
+            desired.erase(name);
+        }
+        std::string canonical;
+        for (const auto &option : desired) {
+            if (option.first[0] == '.') {
+                continue;
+            }
+            canonical += std::to_string(option.first.size()) + ":" + option.first +
+                         (option.second.list ? "L" : "S");
+            for (const auto &value : option.second.strings) {
+                canonical += std::to_string(value.size()) + ":" + value;
+            }
+            canonical += ";";
+        }
+        mapf::encryption::sha256 hash;
+        hash.update(reinterpret_cast<const uint8_t *>(canonical.data()), canonical.size());
+        uint8_t digest[32];
+        if (!hash.digest(digest)) {
+            return false;
+        }
+        std::string id;
+        constexpr char hex[] = "0123456789abcdef";
+        for (auto value : digest) {
+            id += hex[value >> 4];
+            id += hex[value & 15];
+        }
+        raw.strings.emplace_back("config_id=" + id);
+        values["hostapd_bss_options"] = std::move(raw);
+        auto &expected = expected_config_ids[text(desired, "ifname")];
+        expected["config_id"] = id;
+        expected["start_disabled"] = bss.teardown ? "1" : "0";
+        expected["start_deferred"] = "0";
+        expected["beacon_set"] = bss.teardown ? "0" : "1";
+        if (!bss.teardown) {
+            expected["multi_ap_client_disallow"] =
+                std::to_string((bss.profile1_backhaul_sta_association_disallowed ? 1 : 0) |
+                               (bss.profile2_backhaul_sta_association_disallowed ? 2 : 0));
+            if (!expected_security(desired, expected)) {
+                return false;
+            }
+            if (bss.fronthaul && !backhaul_ssid.empty()) {
+                expected["multi_ap_backhaul_ssid_hex"] =
+                    hex_string(reinterpret_cast<const unsigned char *>(backhaul_ssid.data()),
+                               backhaul_ssid.size());
+                if (backhaul_key.size() == 64) {
+                    auto key = backhaul_key;
+                    std::transform(key.begin(), key.end(), key.begin(),
+                                   [](unsigned char c) { return std::tolower(c); });
+                    expected["multi_ap_backhaul_wpa_psk"] = key;
+                } else {
+                    expected["multi_ap_backhaul_wpa_passphrase"] = backhaul_key;
+                }
+            }
+        }
+    }
+
+    return transaction.publish(updates, removals);
+}
+
+bool bpl_cfg_set_wifi_channel(const std::string &radio_iface, int channel,
+                              beerocks::eWiFiBandwidth bandwidth)
+{
+    std::string section;
+    WirelessTransaction transaction;
+    Sections current;
+    if (!transaction.open() || !transaction.read(current) ||
+        !primary_ap(current, radio_iface, section)) {
+        return false;
+    }
+    const auto device = text(current.at(section), "device");
+    if (device.empty() || !current.count(device) ||
+        text(current.at(device), ".type") != "wifi-device") {
+        return false;
+    }
+    transaction.bind(section);
+    Options values;
+    values["channel"] = Value(std::to_string(channel));
+    if (bandwidth != eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+        auto mode = text(current.at(device), "htmode");
+        const auto digits = mode.find_first_of("0123456789");
+        if (digits == std::string::npos) {
+            return false;
+        }
+        std::string width;
+        switch (bandwidth) {
+        case eWiFiBandwidth::BANDWIDTH_20: width = "20"; break;
+        case eWiFiBandwidth::BANDWIDTH_40: width = "40"; break;
+        case eWiFiBandwidth::BANDWIDTH_80: width = "80"; break;
+        case eWiFiBandwidth::BANDWIDTH_160: width = "160"; break;
+        default: return false;
+        }
+        values["htmode"] = Value(mode.substr(0, digits) + width);
+    }
+    return transaction.publish({{device, values}});
+}
