+    if (cmd.rfind("WPS_PIN", 0) == 0 || cmd.rfind("WPS_AP_PIN", 0) == 0) {
+        return cmd.substr(0, cmd.find(' ')) + " <redacted>";
+    }
+    return cmd;
+}
