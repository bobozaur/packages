+struct Value {
+    bool list = false;
+    std::vector<std::string> strings;
+
+    Value() = default;
+    Value(const std::string &text) : strings{text} {}
+    bool operator==(const Value &other) const
+    {
+        return list == other.list && strings == other.strings;
+    }
+};
+using Options = std::map<std::string, Value>;
+using Sections = std::map<std::string, Options>;
+
+blob_attr *field(blob_attr *message, const char *name)
+{
+    blob_attr *attr;
+    int remaining;
+    blob_for_each_attr(attr, message, remaining) {
+        if (std::string(blobmsg_name(attr)) == name) {
+            return attr;
+        }
+    }
+    return nullptr;
+}
+
+std::string text(const Options &options, const std::string &name)
+{
+    auto it = options.find(name);
+    return it == options.end() || it->second.strings.size() != 1 ? "" : it->second.strings[0];
+}
+
+bool enabled(const Options &options, const std::string &name)
+{
+    auto it = options.find(name);
+    return it != options.end() && !it->second.list &&
+           (text(options, name) == "1" || text(options, name) == "true");
+}
+
+bool primary_ap(const Sections &sections, const std::string &ifname, std::string &name)
+{
+    name.clear();
+    for (const auto &section : sections) {
+        if (text(section.second, ".type") != "wifi-iface" ||
+            text(section.second, "mode") != "ap" ||
+            text(section.second, "ifname") != ifname) continue;
+        if (!name.empty()) return false;
+        name = section.first;
+    }
+    return !name.empty();
+}
+
+// The native rpcd publication owns conflict admission, snapshots and commit.
+// Local reads use the same committed-only UCI view; no CLI/session delta is
+// imported, staged, consumed or removed by this producer.
+class WirelessTransaction {
+public:
+    ~WirelessTransaction()
+    {
+        blob_buf_free(&request);
+        if (context) {
+            ubus_free(context);
+        }
+    }
+
+    bool open() { return (context = ubus_connect(nullptr)) != nullptr; }
+    void bind(const std::string &section) { anchor = section; }
+
+    bool read(Sections &sections)
+    {
+        auto cursor = uci_alloc_context();
+        if (!cursor) {
+            return false;
+        }
+        uci_element *element, *next;
+        uci_foreach_element_safe(&cursor->delta_path, next, element) {
+            uci_list_del(&element->list);
+            free(element->name);
+            free(element);
+        }
+        uci_package *package = nullptr;
+        if (uci_set_conf2dir(cursor, nullptr) || uci_load(cursor, "wireless", &package)) {
+            uci_free_context(cursor);
+            return false;
+        }
+        sections.clear();
+        uci_foreach_element(&package->sections, element) {
+            auto section = uci_to_section(element);
+            auto &values = sections[element->name];
+            values[".type"] = Value(section->type);
+            uci_element *option;
+            uci_foreach_element(&section->options, option) {
+                auto input = uci_to_option(option);
+                auto &value = values[option->name];
+                if (input->type == UCI_TYPE_STRING) {
+                    value.strings.emplace_back(input->v.string);
+                } else {
+                    value.list = true;
+                    uci_element *item;
+                    uci_foreach_element(&input->v.list, item) {
+                        value.strings.emplace_back(item->name);
+                    }
+                }
+            }
+        }
+        uci_free_context(cursor);
+        snapshot = sections;
+        return true;
+    }
+
+    bool publish(Sections desired,
+                 std::map<std::string, std::vector<std::string>> removed = {})
+    {
+        // Read-only primary AP assertion binds radio/ifname/network identity
+        // to the same locked publication, including a new-BSS-only request.
+        if (anchor.empty() || !snapshot.count(anchor)) return false;
+        desired.emplace(anchor, Options{});
+        std::string device;
+        std::set<std::string> credential_owners;
+        for (const auto &section : desired) {
+            const auto type = snapshot.count(section.first)
+                                  ? text(snapshot.at(section.first), ".type") : "wifi-iface";
+            if (type == "wifi-device") {
+                device = section.first;
+            } else if (type == "wifi-iface") {
+                const auto &old = snapshot.count(section.first) ? snapshot.at(section.first)
+                                                                : section.second;
+                device = text(old, "device");
+                if (text(section.second, "start_disabled") == "0") {
+                    credential_owners.insert(section.first);
+                }
+            }
+        }
+        if (device.empty() || !snapshot.count(device)) {
+            return false;
+        }
+
+        // Per-station passwords are additional credential sources. Retire only
+        // bindings to APs whose credentials this publication replaces; retain
+        // the station's key and every other interface binding.
+        for (const auto &section : snapshot) {
+            if (text(section.second, ".type") != "wifi-station" ||
+                (text(section.second, "disabled") == "1" ||
+                 text(section.second, "disabled") == "true") ||
+                text(section.second, "key").empty()) {
+                continue;
+            }
+            Value bindings;
+            bindings.list = true;
+            const bool has_binding = section.second.count("iface") != 0;
+            if (has_binding) {
+                bindings = section.second.at("iface");
+                if (!bindings.list) {
+                    std::istringstream names(bindings.strings[0]);
+                    bindings.strings.clear();
+                    std::string name;
+                    while (names >> name) bindings.strings.push_back(name);
+                    bindings.list = true;
+                    if (bindings.strings.empty()) continue; // scalar-empty is inactive
+                }
+            }
+            // An absent/empty binding also covers APs created by this batch.
+            const bool global = !has_binding || bindings.strings.empty();
+            if (global) {
+                for (const auto &candidate : snapshot) {
+                    if (text(candidate.second, ".type") == "wifi-iface" &&
+                        text(candidate.second, "mode") == "ap") {
+                        bindings.strings.push_back(candidate.first);
+                    }
+                }
+            }
+            const auto size = bindings.strings.size();
+            bindings.strings.erase(std::remove_if(bindings.strings.begin(), bindings.strings.end(),
+                [&](const std::string &name) { return credential_owners.count(name) != 0; }),
+                bindings.strings.end());
+            if (bindings.strings.size() == size && (!global || credential_owners.empty())) continue;
+            if (bindings.strings.empty()) {
+                // Removing the last binding would make it global again.
+                desired[section.first]["disabled"] = Value("1");
+            } else {
+                desired[section.first]["iface"] = std::move(bindings);
+            }
+        }
+
+        blob_buf_init(&request, 0);
+        blobmsg_add_string(&request, "device", device.c_str());
+        add_table("expected_device", snapshot.at(device));
+        auto updates = blobmsg_open_array(&request, "updates");
+        for (const auto &section : desired) {
+            auto update = blobmsg_open_table(&request, nullptr);
+            blobmsg_add_string(&request, "section", section.first.c_str());
+            if (snapshot.count(section.first)) {
+                add_table("expected", snapshot.at(section.first));
+            } else {
+                blobmsg_add_field(&request, BLOBMSG_TYPE_UNSPEC, "expected", nullptr, 0);
+            }
+            auto values = blobmsg_open_table(&request, "values");
+            add_options(section.second, true);
+            for (const auto &name : removed[section.first]) {
+                if (!section.second.count(name)) {
+                    blobmsg_add_field(&request, BLOBMSG_TYPE_UNSPEC, name.c_str(), nullptr, 0);
+                }
+            }
+            blobmsg_close_table(&request, values);
+            blobmsg_close_table(&request, update);
+        }
+        blobmsg_close_array(&request, updates);
+
+        uint32_t id;
+        if (ubus_lookup_id(context, "uci", &id)) {
+            return false;
+        }
+        bool saved = false;
+        auto receive = [](ubus_request *req, int, blob_attr *message) {
+            auto status = field(message, "status");
+            if (status && blobmsg_type(status) == BLOBMSG_TYPE_STRING) {
+                *static_cast<bool *>(req->priv) =
+                    std::string(blobmsg_get_string(status)) == "saved";
+            }
+        };
+        return ubus_invoke(context, id, "wireless_apply", request.head, receive, &saved, 5000) == 0 &&
+               saved;
+    }
+
+private:
+    void add_options(const Options &options, bool empty_is_absent = false)
+    {
+        for (const auto &option : options) {
+            if (option.second.list) {
+                auto array = blobmsg_open_array(&request, option.first.c_str());
+                for (const auto &value : option.second.strings) {
+                    blobmsg_add_string(&request, nullptr, value.c_str());
+                }
+                blobmsg_close_array(&request, array);
+            } else if (empty_is_absent && option.second.strings[0].empty()) {
+                // libuci set of an empty scalar removes that option.
+                blobmsg_add_field(&request, BLOBMSG_TYPE_UNSPEC, option.first.c_str(), nullptr, 0);
+            } else {
+                blobmsg_add_string(&request, option.first.c_str(), option.second.strings[0].c_str());
+            }
+        }
+    }
+    void add_table(const char *name, const Options &options)
+    {
+        auto table = blobmsg_open_table(&request, name);
+        add_options(options);
+        blobmsg_close_table(&request, table);
+    }
+
+    ubus_context *context = nullptr;
+    blob_buf request = {};
+    Sections snapshot;
+    std::string anchor;
+};
+
+bool owned_directive(const std::string &name)
+{
+    static const std::set<std::string> names = {
+        "interface", "bss", "bssid", "ctrl_interface", "bridge", "ssid", "ssid2",
+        "auth_algs", "wpa", "wpa_key_mgmt", "wpa_pairwise", "rsn_pairwise", "wpa_group",
+        "wpa_passphrase", "wpa_psk", "wpa_psk_file", "wpa_psk_file_static", "wpa_psk_radius",
+        "sae_password", "sae_password_file", "ieee80211w", "ieee8021x", "eap_server",
+        "auth_server_addr", "auth_server_port", "auth_server_shared_secret",
+        "start_disabled", "start_deferred", "ignore_broadcast_ssid", "wps_state",
+        "wps_independent", "notify_mgmt_frames", "config_id"
+    };
+    return names.count(name) || name.rfind("multi_ap", 0) == 0 ||
+           name.rfind("rsn_override", 0) == 0;
+}
+
+Value unrelated_options(const Options &current)
+{
+    Value result;
+    result.list = true;
+    auto raw = current.find("hostapd_bss_options");
+    if (raw == current.end()) {
+        return result;
+    }
+    for (const auto &value : raw->second.strings) {
+        std::istringstream lines(value);
+        std::string line;
+        while (std::getline(lines, line)) {
+            const auto begin = line.find_first_not_of(" \t\r");
+            const auto equal = line.find('=', begin);
+            if (begin != std::string::npos && equal != std::string::npos) {
+                const auto end = line.find_last_not_of(" \t", equal - 1);
+                if (end != std::string::npos && owned_directive(line.substr(begin, end - begin + 1))) {
+                    continue;
+                }
+            }
+            result.strings.push_back(line);
+        }
+    }
+    return result;
+}
+
+std::string hex_string(const unsigned char *bytes, size_t length)
+{
+    constexpr char hex[] = "0123456789abcdef";
+    std::string result;
+    for (size_t i = 0; i < length; ++i) {
+        result += hex[bytes[i] >> 4];
+        result += hex[bytes[i] & 15];
+    }
+    return result;
+}
+
+std::string raw_value(const Options &options, const std::string &name)
+{
+    std::string result;
+    auto raw = options.find("hostapd_bss_options");
+    if (raw == options.end()) return result;
+    for (const auto &entry : raw->second.strings) {
+        std::istringstream lines(entry);
+        std::string line;
+        while (std::getline(lines, line)) {
+            auto begin = line.find_first_not_of(" \t\r");
+            auto equal = line.find('=', begin);
+            if (begin == std::string::npos || equal == std::string::npos) continue;
+            auto end = line.find_last_not_of(" \t", equal - 1);
+            if (end != std::string::npos && line.substr(begin, end - begin + 1) == name)
+                result = line.substr(equal + 1);
+        }
+    }
+    return result;
+}
+
+const std::vector<std::string> credential_overrides = {
+    "sae_password", "sae_password_file", "wpa_psk_file", "ppsk", "dpp",
+    "auth_server", "auth_server_addr", "auth_server_shared_secret", "wpa_psk",
+    "wpa_passphrase", "wpa_psk_radius", "wpa_psk_file_static", "wpa_key_mgmt",
+    "rsn_override_key_mgmt", "rsn_override_pairwise", "rsn_override_mfp",
+    "rsn_override_key_mgmt_2", "rsn_override_pairwise_2", "rsn_override_mfp_2"
+};
+
+bool native_security_policy(const Options &old, const Options &device, Options &values)
+{
+    if (text(values, "start_disabled") == "1") return true;
+    // This stock backend implements the basic non-MLD radio contract. Do not
+    // publish a security mode that the native 6 GHz/EHT generator transforms.
+    if (text(device, "band") == "6g" || text(device, "htmode").rfind("EHT", 0) == 0) {
+        LOG(ERROR) << "Controller security requires an unsupported 6 GHz/EHT radio policy";
+        return false;
+    }
+    const bool secured = text(values, "encryption") != "none";
+    const bool raw_ocv = std::strtol(raw_value(old, "ocv").c_str(), nullptr, 10) != 0;
+    const bool mbo = enabled(old, "mbo") ||
+        std::strtol(raw_value(old, "mbo").c_str(), nullptr, 10) != 0;
+    if (!secured && (raw_ocv || enabled(old, "hs20") ||
+        std::strtol(raw_value(old, "hs20").c_str(), nullptr, 10) != 0)) {
+        LOG(ERROR) << "Controller open security conflicts with retained native policy";
+        return false;
+    }
+    // Native MBO/OCV requires optional PMF with WPA2. Keep these features
+    // and deliberately publish/read back the same legal native policy.
+    if (secured && text(values, "ieee80211w") == "0" &&
+        (mbo || enabled(old, "ocv") || raw_ocv))
+        values["ieee80211w"] = Value("1");
+    return true;
+}
+
+bool expected_security(const Options &desired,
+                       std::unordered_map<std::string, std::string> &expected)
+{
+    const auto encryption = text(desired, "encryption");
+    const auto ssid = text(desired, "ssid");
+    expected["ssid_hex"] = hex_string(
+        reinterpret_cast<const unsigned char *>(ssid.data()), ssid.size());
+    expected["ieee80211w"] = text(desired, "ieee80211w");
+    expected["multi_ap"] = text(desired, "multi_ap") == "0" ? "" : text(desired, "multi_ap");
+    expected["sae_password_count"] = "0";
+    if (encryption == "none") {
+        expected["wpa"] = "";
+        expected["key_mgmt"] = "";
+        expected["wpa_psk_count"] = "0";
+        return true;
+    }
+    expected["wpa"] = "2";
+    const bool sae = encryption.find("sae") != std::string::npos;
+    const bool psk = encryption.find("psk") != std::string::npos ||
+                     encryption.find("mixed") != std::string::npos;
+    const bool pmf = text(desired, "ieee80211w") != "0";
+    const bool ft = enabled(desired, "ieee80211r");
+    const bool sae_ext = enabled(desired, "sae_ext_key");
+    std::string akm;
+    auto append = [&](const std::string &name) {
+        if (!akm.empty()) akm += " ";
+        akm += name;
+    };
+    if (sae) {
+        append("SAE");
+        if (sae_ext) append("SAE-EXT-KEY");
+        if (ft) {
+            append("FT-SAE");
+            if (sae_ext) append("FT-SAE-EXT-KEY");
+        }
+    }
+    if (psk) {
+        append("WPA-PSK");
+        if (ft) append("FT-PSK");
+        if (pmf) append("WPA-PSK-SHA256");
+    }
+    expected["key_mgmt"] = akm;
+    const bool tkip = encryption.find("tkip") != std::string::npos;
+    expected["rsn_pairwise_cipher"] = tkip ? "TKIP CCMP" : "CCMP";
+    expected["group_cipher"] = tkip ? "TKIP" : "CCMP";
+    expected["wpa_psk_count"] = "1";
+    auto key = text(desired, "key");
+    if (key.size() == 64) {
+        std::transform(key.begin(), key.end(), key.begin(),
+                       [](unsigned char c) { return std::tolower(c); });
+        expected["psk"] = key;
+    } else {
+        unsigned char psk_bytes[32];
+        if (!PKCS5_PBKDF2_HMAC_SHA1(key.data(), key.size(),
+                reinterpret_cast<const unsigned char *>(ssid.data()), ssid.size(),
+                4096, sizeof(psk_bytes), psk_bytes)) {
+            return false;
+        }
+        expected["psk"] = hex_string(psk_bytes, sizeof(psk_bytes));
+        expected["passphrase"] = key;
+        OPENSSL_cleanse(psk_bytes, sizeof(psk_bytes));
+    }
+    return true;
+}
+
+bool credentials(const son::wireless_utils::sBssInfoConf &bss, Options &values)
+{
+    if (std::any_of(bss.network_key.begin(), bss.network_key.end(),
+                    [](unsigned char value) { return value < 0x20 || value == 0x7f; })) {
+        return false;
+    }
+    if (bss.teardown) {
+        // Keep the real radio's control interface available for the next M2.
+        values["start_disabled"] = Value("1");
+        return true;
+    }
+    const auto auth = static_cast<uint16_t>(bss.authentication_type);
+    const auto wpa2 = static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_WPA2PSK);
+    const auto sae = static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_SAE);
+    std::string encryption, pmf = "0";
+    if (bss.authentication_type == WSC::eWscAuth::WSC_AUTH_OPEN &&
+        bss.encryption_type == WSC::eWscEncr::WSC_ENCR_NONE) {
+        encryption = "none";
+    } else {
+        if ((auth != wpa2 && auth != sae && auth != (wpa2 | sae)) ||
+            !(static_cast<uint16_t>(bss.encryption_type) &
+              static_cast<uint16_t>(WSC::eWscEncr::WSC_ENCR_AES)) ||
+            bss.network_key.size() < 8 || bss.network_key.size() > 64) {
+            return false;
+        }
+        if (bss.network_key.size() == 64 &&
+            (auth != wpa2 || bss.network_key.find_first_not_of("0123456789abcdefABCDEF") !=
+                                std::string::npos)) {
+            return false;
+        }
+        if (auth == sae || auth == (wpa2 | sae)) {
+            if (bss.encryption_type != WSC::eWscEncr::WSC_ENCR_AES) {
+                return false;
+            }
+            encryption = auth == sae ? "sae" : "sae-mixed";
+            pmf = auth == sae ? "2" : "1";
+        } else {
+            encryption = "psk2";
+        }
+        encryption += (static_cast<uint16_t>(bss.encryption_type) &
+                       static_cast<uint16_t>(WSC::eWscEncr::WSC_ENCR_TKIP))
+                          ? "+tkip+ccmp"
+                          : "+ccmp";
+        values["key"] = Value(bss.network_key);
+    }
+    if (bss.ssid.empty() || bss.ssid.size() > 32) {
+        return false;
+    }
+    values["ssid"] = Value(bss.ssid);
+    values["encryption"] = Value(encryption);
+    values["ieee80211w"] = Value(pmf);
+    values["multi_ap"] = Value(std::to_string((bss.backhaul ? 1 : 0) |
+                                              (bss.fronthaul ? 2 : 0)));
+    values["start_disabled"] = Value("0");
+    values["wds"] = Value(bss.backhaul ? "1" : "0");
+    if (bss.hidden_ssid != WSC::eWscVendorExtHiddenSsid::UNSET) {
+        values["hidden"] = Value(bss.hidden_ssid == WSC::eWscVendorExtHiddenSsid::ENABLED ? "1" : "0");
+    }
+    values["wps_pushbutton"] = Value(bss.fronthaul ? "1" : "0");
+    values["wps_state"] = Value(bss.fronthaul ? "2" : "0");
+    return true;
+}
+
+bool matches_owned_bss(const Options &candidate, const Options &primary,
+                       const Options &device,
+                       const son::wireless_utils::sBssInfoConf &bss,
+                       const std::string &backhaul_ssid, const std::string &backhaul_key)
+{
+    Options wanted;
+    if (bss.teardown || !credentials(bss, wanted) ||
+        !native_security_policy(candidate, device, wanted)) return false;
+    wanted["multi_ap_backhaul_ssid"] = Value(bss.fronthaul ? backhaul_ssid : "");
+    wanted["multi_ap_backhaul_key"] = Value(bss.fronthaul ? backhaul_key : "");
+    for (const auto &value : wanted)
+        if (text(candidate, value.first) != text(wanted, value.first)) return false;
+    for (const auto &name : credential_overrides)
+        if (candidate.count(name)) return false;
+    auto network = candidate.find("network");
+    auto primary_network = primary.find("network");
+    if ((network == candidate.end()) != (primary_network == primary.end()) ||
+        (network != candidate.end() && !(network->second == primary_network->second))) return false;
+    const auto profile = std::to_string(
+        (bss.profile1_backhaul_sta_association_disallowed ? 1 : 0) |
+        (bss.profile2_backhaul_sta_association_disallowed ? 2 : 0));
+    const auto id = raw_value(candidate, "config_id");
+    return raw_value(candidate, "multi_ap_client_disallow") == profile &&
+           id.size() == 64 && id.find_first_not_of("0123456789abcdef") == std::string::npos;
+}
