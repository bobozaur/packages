+        /** Convert native MCS maps and HT/VHT attributes to the existing Multi-AP wire fields. */
+        static uint8_t mcs_map_nss(const uint8_t *map)
+        {
+            const uint16_t bits = map[0] | (uint16_t(map[1]) << 8);
+            uint8_t streams = 0;
+            for (uint8_t i = 0; i < 8; ++i) {
+                if (((bits >> (2 * i)) & 3) != 3) streams = i + 1;
+            }
+            return streams;
+        }
+
+        bool get_multi_ap_ht_capability(uint8_t &value) const
+        {
+            value = 0;
+            if (!ht_supported) return true;
+            if (!ht_mcs_valid) return false;
+            uint8_t rx = 0;
+            for (uint8_t i = 0; i < 4; ++i) {
+                if (ht_mcs_set[i]) rx = i + 1;
+            }
+            if (!rx) return false;
+            // Defined unequal Tx MCS set: bits2-3 encode maximum Tx streams minus1.
+            const uint8_t tx = (ht_mcs_set[12] & 3) == 3 ?
+                ((ht_mcs_set[12] >> 2) & 3) + 1 : rx;
+            value = ((tx - 1) << 6) | ((rx - 1) << 4) |
+                (bool(ht_capability & (1 << 5)) << 3) |
+                (bool(ht_capability & (1 << 6)) << 2) |
+                (bool(ht_capability & (1 << 1)) << 1);
+            return true;
+        }
+
+        bool get_multi_ap_vht_capability(uint16_t &value) const
+        {
+            value = 0;
+            if (!vht_supported) return true;
+            if (!vht_mcs_valid) return false;
+            const auto rx = mcs_map_nss(vht_mcs_set), tx = mcs_map_nss(vht_mcs_set + 4);
+            if (!rx || !tx) return false;
+            const auto width = (vht_capability >> 2) & 3;
+            if (width == 3) return false;
+            value = ((tx - 1) << 13) | ((rx - 1) << 10) |
+                (bool(vht_capability & (1 << 5)) << 9) |
+                (bool(vht_capability & (1 << 6)) << 8) |
+                ((width == 2) << 7) | ((width == 1 || width == 2) << 6) |
+                (bool(vht_capability & (1 << 11)) << 5) |
+                (bool(vht_capability & (1 << 19)) << 4);
