+bool cfg_get_radio_inventory(std::vector<BPL_RADIO_IFACES> &radios)
+{
+    WirelessTransaction transaction;
+    Sections mesh, wireless;
+    std::set<std::string> endpoints, devices;
+    std::set<unsigned long> numbers;
+    radios.clear();
+    if (!transaction.read(mesh, "prplmesh") || !transaction.read(wireless)) return false;
+    for (const auto &section : mesh) {
+        if (text(section.second, ".type") != "wifi-device") continue;
+        const auto &name = section.first;
+        if (name.size() <= 5 || name.compare(0, 5, "radio") ||
+            name.find_first_not_of("0123456789", 5) != std::string::npos) return false;
+        const auto number = strtoul(name.c_str() + 5, nullptr, 10);
+        if (number >= BPL_NUM_OF_INTERFACES || !numbers.insert(number).second) return false;
+        for (const auto *field_name : {"hostap_iface", "sta_iface", "wireless_device"}) {
+            const auto option = section.second.find(field_name);
+            if (option != section.second.end() && option->second.list) return false;
+        }
+        BPL_RADIO_IFACES radio{};
+        radio.radio_num = number;
+        radio.hostap_iface = text(section.second, "hostap_iface");
+        radio.sta_iface = text(section.second, "sta_iface");
+        radio.wireless_device = text(section.second, "wireless_device");
+        if (radio.wireless_device.empty()) radio.wireless_device = name;
+        auto device = wireless.find(radio.wireless_device);
+        if ((radio.hostap_iface.empty() && radio.sta_iface.empty()) ||
+            device == wireless.end() || text(device->second, ".type") != "wifi-device" ||
+            (radio.hostap_iface.empty() && enabled(device->second, "disabled")) || !devices.insert(radio.wireless_device).second)
+            return false;
+        for (const auto &endpoint : {radio.hostap_iface, radio.sta_iface}) {
+            if (endpoint.empty()) continue;
+            if (endpoint.size() >= IFNAMSIZ || !endpoints.insert(endpoint).second) return false;
+            size_t matches = 0;
+            for (const auto &iface : wireless) {
+                const auto &values = iface.second;
+                if (text(values, ".type") != "wifi-iface" || text(values, "ifname") != endpoint) continue;
+                for (const auto *field_name : {"ifname", "device", "mode"}) {
+                    const auto option = values.find(field_name);
+                    if (option == values.end() || option->second.list) return false;
+                }
+                if (text(values, "device") != radio.wireless_device ||
+                    (radio.hostap_iface.empty() && enabled(values, "disabled")) ||
+                    text(values, "mode") != (endpoint == radio.hostap_iface ? "ap" : "sta")) return false;
+                ++matches;
+            }
+            if (matches != 1) return false;
+        }
+        radios.push_back(std::move(radio));
+    }
+    return !radios.empty() && radios.size() <= BPL_NUM_OF_INTERFACES;
+}
