+bool bpl_cfg_sta_only_radio_quiet(const std::string &sta_iface, const std::string &ap_phy,
+                                   const std::string &wireless_device)
+{
+    WirelessTransaction transaction;
+    Sections sections;
+    if (ap_phy.empty() || !transaction.read(sections)) return false;
+    std::string device;
+    for (const auto &section : sections) {
+        const auto &values = section.second;
+        if (text(values, ".type") != "wifi-iface" || text(values, "ifname") != sta_iface) continue;
+        if (!device.empty() || text(values, "mode") != "sta" || enabled(values, "disabled")) return false;
+        device = text(values, "device");
+    }
+    if (device.empty() || device != wireless_device || !sections.count(device) ||
+        text(sections.at(device), ".type") != "wifi-device" || enabled(sections.at(device), "disabled")) return false;
+    for (const auto &section : sections) {
+        const auto &values = section.second;
+        if (text(values, ".type") == "wifi-iface" && text(values, "device") == device &&
+            text(values, "mode") == "ap") return false;
+    }
+    auto context = ubus_connect(nullptr);
+    if (!context) return false;
+    uint32_t id;
+    struct Result { const std::string &phy; bool observed = false; bool ap = false; bool valid = true; } result{ap_phy};
+    auto receive = [](ubus_request *request, int, blob_attr *message) {
+        auto &result = *static_cast<Result *>(request->priv);
+        auto interfaces = field(message, "interfaces");
+        if (!interfaces || blobmsg_type(interfaces) != BLOBMSG_TYPE_TABLE) return;
+        result.observed = true;
+        blob_attr *iface;
+        int remaining;
+        blobmsg_for_each_attr(iface, interfaces, remaining) {
+            blob_attr *phy = nullptr, *entry;
+            int nested_remaining;
+            blobmsg_for_each_attr(entry, iface, nested_remaining) {
+                if (std::string(blobmsg_name(entry)) == "wiphy") phy = entry;
+            }
+            if (!phy || blobmsg_type(phy) != BLOBMSG_TYPE_STRING) {
+                result.valid = false;
+                continue;
+            }
+            if (result.phy == blobmsg_get_string(phy)) result.ap = true;
+        }
+    };
+    bool quiet = !ubus_lookup_id(context, "hostapd", &id) &&
+        !ubus_invoke(context, id, "status", nullptr, receive, &result, 2000) &&
+        result.observed && result.valid && !result.ap;
+    ubus_free(context);
+    return quiet;
+}
 
