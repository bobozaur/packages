+bool AgentDB::refresh_sta_only_radio(AgentDB::sRadio &target)
+{
+    if (target.has_ap() || target.back.iface_name.empty()) return false;
+    auto updated = target;
+    auto &radio = updated;
+    auto client = bwl::nl80211_client_factory::create_instance();
+    bwl::nl80211_client::interface_info iface{};
+    std::vector<bwl::nl80211_client::physical_radio> phys;
+    if (!client || !client->get_interface_info(radio.back.iface_name, iface) ||
+        iface.name != radio.back.iface_name || !iface.index ||
+        iface.addr == net::network_utils::ZERO_MAC || (iface.addr.oct[0] & 1) ||
+        iface.type != NL80211_IFTYPE_STATION || !client->get_physical_radios(phys)) return false;
+    auto sta = std::find_if(phys.begin(), phys.end(), [&](const auto &p) {
+        return p.index == iface.wiphy;
+    });
+    if (sta == phys.end() || sta->device_path.empty() ||
+        sta->permanent_mac == net::network_utils::ZERO_MAC ||
+        (sta->permanent_mac.oct[0] & 1)) return false;
+    const bwl::nl80211_client::physical_radio *ap = nullptr;
+    for (const auto &phy : phys) {
+        if (!phy.supports_ap || !phy.max_ap_interfaces ||
+            phy.device_path != sta->device_path || phy.permanent_mac != sta->permanent_mac) continue;
+        if (ap) return false; // Ambiguous physical identity is not a radio pairing.
+        ap = &phy;
+    }
+    bwl::nl80211_client::radio_info info;
+    if (!ap || !client->get_radio_info_by_phy(ap->index, info)) return false;
+    auto band = info.bands.end();
+    const auto current_band = son::wireless_utils::which_freq_type(iface.frequency);
+    for (auto it = info.bands.begin(); it != info.bands.end(); ++it) {
+        if (it->supported_channels.empty()) continue;
+        if (current_band != eFreqType::FREQ_UNKNOWN && it->get_frequency_band() != current_band) continue;
+        if (band != info.bands.end()) return false; // Need an unambiguous operating band.
+        band = it;
+    }
+    if (band == info.bands.end() ||
+        (band->ht_supported && !band->ht_mcs_valid) ||
+        (band->vht_supported && !band->vht_mcs_valid) ||
+        (band->he_supported && (!band->he_mcs_valid || !band->he_data_valid))) return false;
+    if (target.radio_uid() != net::network_utils::ZERO_MAC &&
+        (target.radio_uid() != sta->permanent_mac || target.physical_device_path != sta->device_path))
+        return false;
+    for (const auto *other : get_radios_list()) {
+        if (other == &target) continue;
+        if (other->radio_uid() != net::network_utils::ZERO_MAC &&
+            other->radio_uid() == sta->permanent_mac) return false;
+        if (!other->has_ap()) continue;
+        bwl::nl80211_client::interface_info endpoint{};
+        if (!client->get_interface_info(other->front.iface_name, endpoint) ||
+            endpoint.name != other->front.iface_name || endpoint.type != NL80211_IFTYPE_AP) return false;
+        const auto owner = std::find_if(phys.begin(), phys.end(), [&](const auto &p) {
+            return p.index == endpoint.wiphy;
+        });
+        if (owner == phys.end() || (owner->device_path == sta->device_path &&
+            owner->permanent_mac == sta->permanent_mac)) return false;
+    }
+    radio.front.iface_mac = sta->permanent_mac; // Protocol RUID, not an operating AP/BSSID.
+    radio.back.iface_mac = iface.addr;
+    radio.capability_band = band->get_frequency_band();
+    if (radio.capability_band == eFreqType::FREQ_UNKNOWN) return false;
+    radio.capability_phy = ap->name;
+    radio.physical_device_path = sta->device_path;
+    if (!bpl::bpl_cfg_sta_only_radio_quiet(radio.back.iface_name, ap->name, radio.wireless_device)) return false;
+    radio.front.radio_max_bss = std::min<uint32_t>(ap->max_ap_interfaces, radio.front.bssids.size());
+    radio.front.zwdfs = false;
+    radio.front.hybrid_mode_supported = false;
+    radio.front.max_supported_bw = band->get_max_bandwidth();
+    radio.max_supported_bw = band->get_max_bandwidth();
+    radio.number_of_antennas = 0;
+    radio.antenna_gain_dB = 0;
+    radio.tx_power_dB = 0;
+    if (iface.frequency) {
+        uint32_t power = UINT32_MAX;
+        if (!client->get_tx_power_dbm(radio.back.iface_name, power) || power > UINT8_MAX) return false;
+        radio.tx_power_dB = power;
+    }
+    radio.sta_iface_filter_low = false;
+    radio.ht_supported = band->ht_supported;
+    radio.vht_supported = band->vht_supported;
+    if (!band->get_multi_ap_ht_capability(radio.ht_capability) ||
+        !band->get_multi_ap_vht_capability(radio.vht_capability)) return false;
+    std::copy_n(band->ht_mcs_set, radio.ht_mcs_set.size(), radio.ht_mcs_set.begin());
+    std::copy_n(band->vht_mcs_set, radio.vht_mcs_set.size(), radio.vht_mcs_set.begin());
+    radio.he_supported = band->he_supported;
+    radio.he_capability = band->he_capability;
+    if (radio.he_supported) {
+        const auto rx = band->mcs_map_nss(band->he_mcs_set),
+                   tx = band->mcs_map_nss(band->he_mcs_set + 2);
+        if (!rx || !tx) return false;
+        net::sHECapabilities he{};
+        static_assert(sizeof(he) == sizeof(radio.he_capability), "HE capability storage size");
+        std::memcpy(&he, &radio.he_capability, sizeof(he));
+        he.max_num_of_supported_rx_spatial_streams = rx - 1;
+        he.max_num_of_supported_tx_spatial_streams = tx - 1;
+        std::memcpy(&radio.he_capability, &he, sizeof(he));
+    }
+    radio.wifi6_capability = band->wifi6_capability;
+    std::copy_n(band->he_mcs_set, radio.he_mcs_set.size(), radio.he_mcs_set.begin());
+    radio.supported_standards = radio.he_supported ? "ax" : radio.vht_supported ? "ac" : "n";
+    radio.channels_list.clear();
+    for (const auto &entry : band->supported_channels) {
+        const auto &channel = entry.second;
+        auto &out = radio.channels_list[entry.first];
+        out.tx_power_dbm = channel.tx_power;
+        out.dfs_state = beerocks_message::eDfsState::NOT_DFS;
+        if (channel.is_dfs) {
+            switch (channel.dfs_state) {
+            case eDfsState::USABLE:
+                out.dfs_state = beerocks_message::eDfsState::USABLE;
+                break;
+            case eDfsState::UNAVAILABLE:
+                out.dfs_state = beerocks_message::eDfsState::UNAVAILABLE;
+                break;
+            case eDfsState::AVAILABLE:
+                out.dfs_state = beerocks_message::eDfsState::AVAILABLE;
+                break;
+            default:
+                return false;
+            }
+        }
+        for (auto width : channel.supported_bandwidths) {
+            beerocks_message::sSupportedBandwidth bw{};
+            bw.bandwidth = width;
+            bw.rank = 1;
+            bw.multiap_preference = 14;
+            out.supported_bw_list.push_back(bw);
+        }
+    }
+    radio.wifi_channel = WifiChannel();
+    if (iface.frequency) {
+        if (iface.frequency_center2 || (iface.bandwidth != 20 && iface.bandwidth != 40 &&
+            iface.bandwidth != 80 && iface.bandwidth != 160)) return false;
+        eWiFiBandwidth width = eWiFiBandwidth::BANDWIDTH_20;
+        if (iface.bandwidth == 40) width = eWiFiBandwidth::BANDWIDTH_40;
+        else if (iface.bandwidth == 80) width = eWiFiBandwidth::BANDWIDTH_80;
+        else if (iface.bandwidth == 160) width = eWiFiBandwidth::BANDWIDTH_160;
+        radio.wifi_channel = WifiChannel(iface.channel, radio.capability_band, width);
+    }
+    if (!radio.front.radio_max_bss) return false;
+    target = std::move(updated);
+    return true;
+}
