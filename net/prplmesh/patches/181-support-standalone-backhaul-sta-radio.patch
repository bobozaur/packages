+bool nl80211_client_impl::get_physical_radios(std::vector<physical_radio> &radios)
+{
+    std::map<uint32_t, physical_radio> found;
+    std::set<uint32_t> combinations;
+    radios.clear();
+    if (!m_socket) return false;
+    bool ok = m_socket->send_receive_msg(
+        NL80211_CMD_GET_WIPHY, NLM_F_DUMP,
+        [](struct nl_msg *msg) {
+            nla_put_flag(msg, NL80211_ATTR_SPLIT_WIPHY_DUMP);
+            return true;
+        },
+        [&](struct nl_msg *msg) {
+            struct nlattr *tb[NL80211_ATTR_MAX + 1]{};
+            auto *gnlh = static_cast<genlmsghdr *>(nlmsg_data(nlmsg_hdr(msg)));
+            if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+                          genlmsg_attrlen(gnlh, 0), nullptr) || !tb[NL80211_ATTR_WIPHY]) return;
+            auto index = nla_get_u32(tb[NL80211_ATTR_WIPHY]);
+            auto &phy = found[index];
+            phy.index = index;
+            if (tb[NL80211_ATTR_WIPHY_NAME]) phy.name = nla_get_string(tb[NL80211_ATTR_WIPHY_NAME]);
+            if (tb[NL80211_ATTR_MAC] && nla_len(tb[NL80211_ATTR_MAC]) == ETH_ALEN)
+                memcpy(phy.permanent_mac.oct, nla_data(tb[NL80211_ATTR_MAC]), ETH_ALEN);
+            if (tb[NL80211_ATTR_SUPPORTED_IFTYPES]) {
+                struct nlattr *type;
+                int remaining;
+                nla_for_each_nested(type, tb[NL80211_ATTR_SUPPORTED_IFTYPES], remaining) {
+                    if (nla_type(type) == NL80211_IFTYPE_AP) phy.supports_ap = true;
+                }
+            }
+            if (!tb[NL80211_ATTR_INTERFACE_COMBINATIONS]) return;
+            combinations.insert(index);
+            struct nlattr *combination;
+            int remaining;
+            nla_for_each_nested(combination, tb[NL80211_ATTR_INTERFACE_COMBINATIONS], remaining) {
+                struct nlattr *comb[NUM_NL80211_IFACE_COMB]{};
+                if (nla_parse_nested(comb, MAX_NL80211_IFACE_COMB, combination, nullptr) ||
+                    !comb[NL80211_IFACE_COMB_LIMITS] || !comb[NL80211_IFACE_COMB_MAXNUM]) continue;
+                auto total = nla_get_u32(comb[NL80211_IFACE_COMB_MAXNUM]);
+                struct nlattr *limit;
+                int rem_limit;
+                nla_for_each_nested(limit, comb[NL80211_IFACE_COMB_LIMITS], rem_limit) {
+                    struct nlattr *attrs[NUM_NL80211_IFACE_LIMIT]{};
+                    if (nla_parse_nested(attrs, MAX_NL80211_IFACE_LIMIT, limit, nullptr) ||
+                        !attrs[NL80211_IFACE_LIMIT_MAX] || !attrs[NL80211_IFACE_LIMIT_TYPES]) continue;
+                    struct nlattr *type;
+                    int rem_type;
+                    nla_for_each_nested(type, attrs[NL80211_IFACE_LIMIT_TYPES], rem_type) {
+                        if (nla_type(type) == NL80211_IFTYPE_AP)
+                            phy.max_ap_interfaces = std::max(phy.max_ap_interfaces,
+                                std::min(total, nla_get_u32(attrs[NL80211_IFACE_LIMIT_MAX])));
+                    }
+                }
+            }
+        });
+    if (!ok) return false;
+    for (auto &entry : found) {
+        auto &phy = entry.second;
+        char path[PATH_MAX];
+        auto link = "/sys/class/ieee80211/" + phy.name + "/device";
+        if (phy.name.empty() || !realpath(link.c_str(), path)) continue;
+        phy.device_path = path;
+        // Without combinations, nl80211 permits one interface of a supported type.
+        if (phy.supports_ap && !combinations.count(phy.index)) phy.max_ap_interfaces = 1;
+        radios.push_back(std::move(phy));
+    }
+    return !radios.empty();
+}
