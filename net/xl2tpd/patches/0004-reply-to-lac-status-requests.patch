-static int control_handle_lac_status(){
-    show_status ();
+static int control_handle_lac_status(FILE* resf, char* bufp){
+    struct lac *lac;
+    char *name = strchr (bufp, ' ');
+
+    if (name)
+        while (*name == ' ')
+            name++;
+    if (!name || !*name)
+    {
+        write_res (resf, "%02i LAC name required\n", 1);
+        return 0;
+    }
+
+    lac = laclist;
+    while (lac && strcasecmp (lac->entname, name))
+        lac = lac->next;
+    if (!lac && deflac && !strcasecmp (deflac->entname, name))
+        lac = deflac;
+    if (!lac)
+    {
+        write_res (resf, "%02i No such tunnel '%s'\n", 1, name);
+        return 0;
+    }
+
+    write_res (resf, "%02i OK\n", 0);
+    write_res (resf, "%02i STATUS name=%s\n", 0, lac->entname);
+    write_res (resf, "%02i STATUS active=%d\n", 0, !!lac->active);
+    write_res (resf, "%02i STATUS tunnel_id=%u\n", 0,
+               lac->t ? (unsigned int)lac->t->ourtid : 0);
+    write_res (resf, "%02i STATUS call_id=%u\n", 0,
+               lac->c ? (unsigned int)lac->c->ourcid : 0);
     return 1;
 }
 
