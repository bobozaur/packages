@@ -496,12 +497,21 @@
 
     {
         struct ppp_opts *p = opts;
-        int maxn_opts = sizeof(stropt) / sizeof(stropt[0]) - 1;
+        int named = c->lns && c->lns->ppp_ifname[0];
+        int maxn_opts = sizeof(stropt) / sizeof(stropt[0]) - 1 - (named ? 2 : 0);
         while (p && pos < maxn_opts)
         {
             stropt[pos] = strdup (p->option);
             pos++;
             p = p->next;
+        }
+        if (p)
+        {
+            l2tp_log(LOG_WARNING, "Too many PPP options for call\n");
+            while (pos)
+                free(stropt[--pos]);
+            close(fd2);
+            return -E2BIG;
         }
         stropt[pos] = NULL;
     }
@@ -578,6 +588,17 @@
         if( c->dialing[0] )
         {
             setenv( "CALLER_ID", c->dialing, 1 );
+        }
+        if (c->lns && c->lns->ppp_ifname[0])
+        {
+            /* pppd receives nodetach, so the executing child owns this name
+             * throughout the link lifetime. L2TP call IDs can retire sooner.
+             * Child-local argv/storage requires no additional allocation. */
+            snprintf(ppp_ifname, sizeof(ppp_ifname), "%s%08x",
+                     c->lns->ppp_ifname, (unsigned)getpid());
+            stropt[pos++] = "ifname";
+            stropt[pos++] = ppp_ifname;
+            stropt[pos] = NULL;
         }
         execv (PPPD, stropt);
         l2tp_log (LOG_WARNING, "%s: Exec of %s failed!\n", __FUNCTION__, PPPD);
@@ -1697,6 +1718,8 @@
     printf("\n");
     exit(1);
 }
