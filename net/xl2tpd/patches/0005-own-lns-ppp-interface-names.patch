From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] xl2tpd: own LNS PPP names and validate replacement configuration

Validate an optional seven-character interface prefix and append the actual
PPP child PID. Add parser-only -t validation so the service owner can reject
an invalid replacement before retiring live clients.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
--- a/file.h
+++ b/file.h
@@ -98,6 +98,7 @@
     int debug;                  /* Debug PPP? */
     int pass_peer;              /* Pass peer IP to pppd as ipparam? */
     char pppoptfile[STRLEN];    /* File containing PPP options */
+    char ppp_ifname[8];         /* Optional LNS prefix, followed by PPP child PID */
     struct tunnel *t;           /* Tunnel of this, if it's ready */
 };
 
--- a/file.c
+++ b/file.c
@@ -674,6 +674,27 @@
         return -1;
     }
     return 0;
+}
+
+/* A call owns the suffix for its entire PPP lifetime. Keep the prefix short
+ * enough for Linux IFNAMSIZ including the eight-digit hexadecimal PPP process ID. */
+int set_ppp_ifname (char *word, char *value, int context, void *item)
+{
+    struct lns *n = item;
+    const unsigned char *p = (const unsigned char *)value;
+
+    if ((context & ~CONTEXT_DEFAULT) != CONTEXT_LNS ||
+        !*p || strlen(value) >= sizeof(n->ppp_ifname))
+        goto invalid;
+    for (; *p; p++)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+              (*p >= '0' && *p <= '9') || *p == '_'))
+            goto invalid;
+    return set_string(word, value, n->ppp_ifname, sizeof(n->ppp_ifname));
+
+invalid:
+    snprintf(filerr, sizeof(filerr), "'%s' requires an LNS interface prefix of 1-7 letters, digits or underscores\n", word);
+    return -1;
 }
 
 int set_pppoptfile (char *word, char *value, int context, void *item)
@@ -1612,6 +1633,7 @@
     {"ppp debug", &set_debug},
     {"pass peer", &set_pass_peer},
     {"pppoptfile", &set_pppoptfile},
+    {"ppp ifname", &set_ppp_ifname},
     {"call rws", &set_rws},
     {"tunnel rws", &set_rws},
     {"flow bit", &set_flow},
