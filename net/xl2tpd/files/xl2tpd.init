#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2015 OpenWrt.org

START=60
USE_PROCD=1

BIN=xl2tpd
RUN_D="/var/run/xl2tpd"
PID_F="/var/run/xl2tpd.pid"

valid_generation() {
	case "$1" in
		"$RUN_D"/config.*) ;;
		*) return 1 ;;
	esac
	local suffix="${1#"$RUN_D/config."}"
	case "$suffix" in ""|*[!A-Za-z0-9]*) return 1 ;; esac
	[ -f "$1/xl2tpd.conf" ] && [ -f "$1/xl2tp-secrets" ]
}

prepare_generation() {
	local result=0
	umask 077
	mkdir -p "$RUN_D" || return 1
	chmod 700 "$RUN_D" || return 1
	NEXT_DIR="$(mktemp -d "$RUN_D/config.XXXXXX")" || return 1
	ucode /usr/share/xl2tpd/uci.uc "$NEXT_DIR" || result=$?
	case "$result" in
		0) ;;
		10)
			cp /etc/xl2tpd/xl2tpd.conf "$NEXT_DIR/xl2tpd.conf" &&
			cp /etc/xl2tpd/xl2tp-secrets "$NEXT_DIR/xl2tp-secrets" || result=1
			[ "$result" = 10 ] && result=0
			;;
	esac
	# Parse the exact staged daemon input before changing any live owner.
	[ "$result" = 0 ] && "$BIN" -t -c "$NEXT_DIR/xl2tpd.conf" -s "$NEXT_DIR/xl2tp-secrets" || {
		rm -rf "$NEXT_DIR"
		return 1
	}
}

reload_service() {
	local active iface previous candidate result=0 submitted=0 retired=0 accepted=0
	# A reload keeps the previous input until its replacement is accepted.
	local PRESERVE_GENERATIONS=1
	prepare_generation || return 1
	candidate="$NEXT_DIR"
	previous="$(readlink "$RUN_D/active")"
	[ -z "$previous" ] || valid_generation "$previous" || {
		rm -rf "$candidate"
		return 1
	}
	active="$(ucode /usr/share/xl2tpd/lac-reload.uc)" || {
		rm -rf "$candidate"
		return 1
	}
	if ucode /usr/share/xl2tpd/lac-reload.uc down $active; then
		if stop; then
			submitted=1
			# Check submission as well as readiness: rc.common start may
			# otherwise hide a failed service set behind service_started.
			if ( rc_procd start_service "$candidate" && service_started ); then
				accepted=1
			else
				result=1
				# A readiness failure does not revoke procd's ownership. Wait
				# for retirement before rollback or deleting candidate files.
				if stop; then
					retired=1
					[ -z "$previous" ] || ( rc_procd start_service "$previous" && service_started )
				fi
			fi
		else
			result=1
		fi
	else
		result=1
	fi
	# Restore the captured owner intent even after a failed replacement. Their
	# normal netifd retry path handles an unavailable daemon; do not leave down.
	for iface in $active; do
		ubus call "network.interface.$iface" up >/dev/null || result=1
	done
	# A later LAC resume error does not undo an accepted daemon generation.
	if [ "$accepted" = 1 ]; then
		if [ -n "$previous" ] && [ "$previous" != "$candidate" ]; then
			# The first stop retired every reader before candidate submission.
			rm -rf "$previous"
		fi
	elif [ "$submitted" = 0 ] || [ "$retired" = 1 ]; then
		rm -rf "$candidate"
	fi
	return "$result"
}

service_triggers() {
	# Identical argv lets procd coalesce this with the LuCI ucitrack fallback.
	procd_add_config_trigger "config.change" "xl2tp" /sbin/service xl2tpd reload
}

start_service() {
	START_DIR=""
	local owned
	# rc.common closes and submits the definition even if this function returns
	# failure. Abort before submission instead; reload submits in a subshell
	# so it can still restore the captured LAC intent after any startup failure.
	owned="$(ucode /usr/share/xl2tpd/lac-reload.uc owner)" || exit 1
	if [ -n "$1" ]; then
		[ -z "$owned" ] || [ "$owned" = "$1" ] || exit 1
		START_DIR="$1"
	elif [ -n "$owned" ]; then
		# Reasserting identical argv preserves a live or respawning daemon.
		START_DIR="$owned"
	elif [ -L "$RUN_D/active" ]; then
		START_DIR="$(readlink "$RUN_D/active")"
	else
		prepare_generation || exit 1
		START_DIR="$NEXT_DIR"
	fi
	valid_generation "$START_DIR" || exit 1
	procd_open_instance
	procd_set_param command "$BIN" -D -l -p "$PID_F" -c "$START_DIR/xl2tpd.conf" -s "$START_DIR/xl2tp-secrets"
	procd_set_param respawn
	procd_close_instance
}

service_started() {
	[ -n "$START_DIR" ] || return 1
	# Reload already retired the old owner; plain start may keep the same PID.
	ucode /usr/share/xl2tpd/lac-reload.uc ready "$START_DIR" || return 1
	ln -sfn "$START_DIR" "$RUN_D/active"
}

service_stopped() {
	# procd delete is asynchronous. Never remove credentials still in use by a
	# daemon or PPP child, and never start a replacement before that owner exits.
	ucode /usr/share/xl2tpd/lac-reload.uc stopped || return 1
	[ "$PRESERVE_GENERATIONS" = 1 ] || rm -rf "$RUN_D" "$PID_F"
}
