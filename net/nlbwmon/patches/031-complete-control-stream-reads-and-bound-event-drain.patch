+/* A Unix stream may split the database header or a record across reads. */
+static ssize_t
+recv_data(int sock, void *buf, size_t len)
+{
+	ssize_t rv;
+	size_t received = 0;
+
+	while (received < len) {
+		rv = recv(sock, (char *)buf + received, len - received, 0);
+		if (rv < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (!rv)
+			break;
+		received += rv;
+	}
+
+	return received;
+}
