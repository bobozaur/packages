+	}
+
+	if (bytes)
+		uloop_timeout_set(&sock_tm, 100);
+}
+
+static void
+handle_client_state(struct ustream *stream)
+{
+	if (stream->write_error ||
+	    (stream->eof && (!request_handled ||
+	                     !ustream_pending_data(stream, true))))
+		handle_client_timeout(&sock_tm);
+}
+
+static void
+handle_client_request(struct ustream *stream, int bytes)
+{
+	char *cmd, *arg, *data, buf[32] = { };
+	int i, len, err = 0;
+
+	if (request_handled)
+		return;
+
+	data = ustream_get_read_buf(stream, &len);
+	if (!data || len <= 0)
+		return;
+	if (len >= sizeof(buf)) {
+		handle_client_timeout(&sock_tm);
+		return;
+	}
+
+	memcpy(buf, data, len);
+	ustream_consume(stream, len);
+	ustream_set_read_blocked(stream, true);
+	request_handled = true;
+
+	cmd = strtok(buf, " \t\n");
+	arg = strtok(NULL, " \t\n");
+	if (cmd) {
+		for (i = 0; i < sizeof(commands) / sizeof(commands[0]); i++) {
+			if (strcmp(commands[i].cmd, cmd))
+				continue;
+			err = commands[i].cb(client.fd.fd, arg);
+			if (err)
+				fprintf(stderr, "Unable to handle '%s' command: %s\n",
+				        cmd, strerror(-err));
+			break;
+		}
+	}
+
+	/* Keep one native control owner until its queued response drains. A slow
+	 * client must not busy-spin in send(EAGAIN) and exclude shutdown signals. */
+	if (err || !ustream_pending_data(stream, true))
+		handle_client_timeout(&sock_tm);
+	else
+		uloop_timeout_set(&sock_tm, 100);
 }
 
