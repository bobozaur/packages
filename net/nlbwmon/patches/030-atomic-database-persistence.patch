+/* The caller retains fd for fsync after the encoder has flushed and closed. */
+static int
+database_save_gzip(struct dbhandle *h, int fd)
+{
+	gzFile gz;
+	int i, out, err = 0, zerr, close_err;
+
+	out = dup(fd);
+	if (out < 0)
+		return -errno;
+	gz = gzdopen(out, "wb9");
+	if (!gz) {
+		close(out);
+		return -ENOMEM;
+	}
+
+	if (gzwrite(gz, h->db, sizeof(*h->db)) != sizeof(*h->db))
+		goto error;
+	for (i = 0; i < db_entries(h->db); i++)
+		if (gzwrite(gz, &h->db->records[i], db_recsize) != db_recsize)
+			goto error;
+	goto out;
+
+error:
+	gzerror(gz, &zerr);
+	err = zerr == Z_ERRNO ? -errno : -EIO;
+out:
+	close_err = database_gzclose(gz);
+	return err ? err : close_err;
+}
+
+static int
+database_save_plain(struct dbhandle *h, int fd)
+{
+	FILE *fp;
+	int i, out, err = 0;
+
+	out = dup(fd);
+	if (out < 0)
+		return -errno;
+	fp = fdopen(out, "wb");
+	if (!fp) {
+		err = -errno;
+		close(out);
+		return err;
+	}
+
+	/* Buffered writes report ENOSPC instead of faulting in a mapped file. */
+	if (fwrite(h->db, sizeof(*h->db), 1, fp) != 1)
+		err = -errno;
+	for (i = 0; !err && i < db_entries(h->db); i++)
+		if (fwrite(&h->db->records[i], db_recsize, 1, fp) != 1)
+			err = -errno;
+	if (fclose(fp) && !err)
+		err = -errno;
+	return err;
+}
+
+/* Keep a period's existing encoding. A compression preference applies to new
+ * periods; changing names would require publishing and retiring two files. */
+static int
+database_path(const char *path, uint32_t timestamp, char *file, size_t len,
+              bool *compress)
+{
+	struct stat s;
+	int i;
+
+	for (i = 1; i >= 0; i--) {
+		if (snprintf(file, len, "%s/%u.db%s", path, timestamp,
+		             i ? ".gz" : "") >= len)
+			return -ENAMETOOLONG;
+		if (!stat(file, &s)) {
+			*compress = i;
+			return 1;
+		}
+		if (errno != ENOENT)
+			return -errno;
+	}
+	if (snprintf(file, len, "%s/%u.db%s", path, timestamp,
+	             *compress ? ".gz" : "") >= len)
+		return -ENAMETOOLONG;
+	return 0;
+}
+
+int
+database_save(struct dbhandle *h, const char *path, uint32_t timestamp,
+              bool compress)
+{
+	uint32_t old_timestamp;
+	char file[PATH_MAX], temp[PATH_MAX], alternate[PATH_MAX];
+	int fd = -1, dirfd, err, exists;
+
+	exists = database_path(path, timestamp, file, sizeof(file), &compress);
+	if (exists < 0)
+		return exists;
+	/* A late-mounted database must be merged before publishing live values. */
+	if (h->pristine && timestamp > 0 && exists)
+		return -EEXIST;
+	if (snprintf(temp, sizeof(temp), "%s/.nlbwmon.XXXXXX", path) >= sizeof(temp) ||
+	    snprintf(alternate, sizeof(alternate), "%s/%u.db%s", path, timestamp,
+	             compress ? "" : ".gz") >= sizeof(alternate))
+		return -ENAMETOOLONG;
+
+	dirfd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (dirfd < 0)
+		return -errno;
+	fd = mkstemp(temp);
+	if (fd < 0) {
+		err = -errno;
+		close(dirfd);
+		return err;
+	}
+	if (fchmod(fd, 0640)) {
+		err = -errno;
+		goto out;
+	}
+
+	old_timestamp = h->db->timestamp;
+	h->db->timestamp = htobe32(timestamp);
+	err = compress ? database_save_gzip(h, fd) : database_save_plain(h, fd);
+	h->db->timestamp = old_timestamp;
+	if (!err && fsync(fd))
+		err = -errno;
+	if (close(fd) && !err)
+		err = -errno;
+	fd = -1;
+	if (err)
+		goto out;
+	if (rename(temp, file)) {
+		err = -errno;
+		goto out;
+	}
+
+	/* Publication, not attempted I/O, ends pristine state. Even a later sync
+	 * error must not make a retry merge our own published counters again. */
+	if (timestamp > 0)
+		h->pristine = false;
+	if (unlink(alternate) && errno != ENOENT)
+		err = -errno;
+	if (fsync(dirfd) && !err)
+		err = -errno;
+out:
+	if (fd >= 0)
+		close(fd);
+	unlink(temp);
+	close(dirfd);
+	return err;
+}
