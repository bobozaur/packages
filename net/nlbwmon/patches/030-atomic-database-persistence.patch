+static int
+database_restore_gzip(struct dbhandle *h, const char *path, uint32_t timestamp)
+{
+	struct database hdr;
+	struct record rec;
+	uint32_t entries, i;
+	gzFile gz;
+	int err = 0, zerr;
+
+	gz = gzopen(path, "rb");
+	if (!gz)
+		return -errno;
+	if (gzread(gz, &hdr, sizeof(hdr)) != sizeof(hdr)) {
+		err = -ERANGE;
+		goto out;
+	}
+	if (be32toh(hdr.magic) != MAGIC || hdr.interval.type == 0 ||
+	    db_timestamp(&hdr) != timestamp) {
+		err = -EINVAL;
+		goto out;
+	}
+
+	entries = db_entries(&hdr);
+	/* Even with a smaller configured limit, consume and validate the whole
+	 * archive. Only the selected records need storage in the staged handle. */
+	for (i = 0; i < entries; i++) {
+		if (gzread(gz, &rec, db_recsize) != db_recsize) {
+			err = -ERANGE;
+			goto out;
+		}
+		if (h && (!h->limit || i < h->limit)) {
+			err = database_insert(h, &rec);
+			if (err)
+				goto out;
+		}
+	}
+	if (gzgetc(gz) != -1) {
+		err = -ERANGE;
+		goto out;
+	}
+	gzerror(gz, &zerr);
+	if (zerr != Z_OK || !gzeof(gz)) {
+		err = zerr == Z_ERRNO ? -errno : -EIO;
+		goto out;
+	}
+	if (h)
+		h->pristine = false;
+out:
+	zerr = database_gzclose(gz);
+	return err ? err : zerr;
+}
