+	/* Validate an archive without starting an owner or changing stored data. */
+	if (check_only) {
+		err = database_load(NULL, opt.db.directory, check_timestamp);
+		if (err)
+			fprintf(stderr, "Unable to validate database %u: %s\n",
+			        check_timestamp, strerror(-err));
+		return err ? 1 : 0;
 	}
 
 	if (!opt.archive_interval.type) {
