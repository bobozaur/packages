 static int
+database_gzread(gzFile gz, void *buf, int size)
+{
+	int len, zerr;
+
+	len = gzread(gz, buf, size);
+	/* A full read can report a truncated member. The next read may clear
+	 * Z_BUF_ERROR, so inspect it before consuming any more input. */
+	gzerror(gz, &zerr);
+	if (zerr != Z_OK || len < 0)
+		return zerr == Z_ERRNO && errno ? -errno : -EIO;
+	return len == size ? 0 : -ERANGE;
+}
+
