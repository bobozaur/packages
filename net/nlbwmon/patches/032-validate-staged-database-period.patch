+	while ((optchr = getopt(argc, argv, "b:i:r:s:o:p:G:I:L:PZV:")) > -1) {
 		switch (optchr) {
 		case 'b':
 			opt.netlink_buffer_size = (int)strtol(optarg, &e, 0);
@@ -313,7 +316,31 @@
 		case 'Z':
 			opt.db.compress = true;
 			break;
+
+		case 'V':
+			errno = 0;
+			value = strtoul(optarg, &e, 10);
+			if (optarg[0] < '0' || optarg[0] > '9' || *e ||
+			    errno || value > UINT32_MAX) {
+				fprintf(stderr, "Invalid database period: %s\n", optarg);
+				return 1;
