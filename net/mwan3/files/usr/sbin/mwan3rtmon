#!/bin/sh

. /lib/functions.sh
. /lib/functions/network.sh
. /lib/mwan3/mwan3.sh

trap_with_arg()
{
	func="$1" ; shift
	pid="$1" ; shift
	for sig ; do
		# shellcheck disable=SC2064
		trap "$func $sig $pid" "$sig"
	done
}

func_trap()
{
	kill -${1} ${2} 2>/dev/null
}

mwan3_add_all_routes()
{
	local tid IP IPT route_line family active_tbls tid initial_state error
	local ipv=$1

	add_active_tbls()
	{
		mwan3_get_iface_id tid "$1"
		config_get family "$1" family ipv4
		config_get initial_state "$1" initial_state "online"
		[ "$family" != "$ipv" ] && return
		if $IPT -S "mwan3_iface_in_$1" &> /dev/null; then
			active_tbls="$active_tbls${tid} "
		fi
	}

	add_route()
	{
		mwan3_get_iface_id tid "$1"
		[ -n "${active_tbls##* $tid *}" ] && return
		error=$(mwan3_route_change add "$tid" "$route_line" 2>&1) ||
			LOG warn "failed to add $route_line to table $tid - error: $error"
	}

	mwan3_update_dev_to_table
	[ "$ipv" = "ipv6" ] && [ $NO_IPV6 -ne 0 ] && return
	if [ "$ipv" = "ipv4" ]; then
		IP="$IP4"
		IPT="$IPT4"
	elif [ "$ipv" = "ipv6" ]; then
		IP="$IP6"
		IPT="$IPT6"
	fi
	tid=0
	active_tbls=" "
	config_foreach add_active_tbls interface
	[ "$active_tbls" = " " ] && return
	mwan3_get_routes | while read -r route_line; do
		mwan3_route_line_dev "tid" "$route_line" "$ipv"
		if [ -n "$tid" ] && [ -z "${active_tbls##* $tid *}" ]; then
			mwan3_route_change add "$tid" "$route_line"
		elif [ -n "${route_line##default*}" ] && [ -n "${route_line##fe80::/64*}" ]; then
			config_foreach add_route interface
		fi
	done
}

mwan3_rtmon_route_handle()
{
	local action route_line route_family family tbl device line tid route_tid IP IPT

	route_line=${1##"Deleted "}
	route_family=$2

	if [ "$route_line" = "$1" ]; then
		action="replace"
		$IPS -! add mwan3_connected_${route_family} ${route_line%% *}
	else
		action="del"
		mwan3_set_connected_${route_family}
	fi

	if [ -z "${route_line##*linkdown*}" ]; then
		LOG debug "attempting to add link on down interface - $route_line"
	fi

	if [ "$route_family" = "ipv4" ]; then
		IP="$IP4"
		IPT="$IPT4"
	elif [ "$route_family" = "ipv6" ] && [ $NO_IPV6 -eq 0 ]; then
		IP="$IP6"
		IPT="$IPT6"
	else
		LOG warn "route update called with invalid family - $route_family"
		return
	fi
	route_line=$(echo "$route_line" | sed -ne "$MWAN3_ROUTE_LINE_EXP")

	if [ "$action" = "del" ]; then
		if mwan3_get_routes | grep -qxF "$route_line"; then
			LOG debug "deleted but route still exists - $route_line"
			return
		fi
	fi

	handle_route() {
		local error
		local iface=$1

		# Probe health does not own the routing table. Untracked interfaces
		# and restarting trackers still need current connected/LAN routes.
		# ifdown removes this chain under the same procd lock as this update.
		if ! $IPT -S "mwan3_iface_in_$iface" >/dev/null 2>&1; then
			LOG debug "interface $iface has no active route owner - skipping '$route_line'"
			return
		fi
		tbl=$($IP route list table $tid proto "$MWAN3_ROUTE_PROTOCOL" 2>/dev/null | sed -ne "$MWAN3_ROUTE_LINE_EXP")$'\n'

		# check that action needs to be performed. May not need to take action if we
		# got a delete event, but table was already flushed
		if [ $action = "del" ] && [ -n "${tbl##*$route_line$'\n'*}" ]; then
			LOG debug "skipping already deleted route table $tid - skipping '$route_line'"
			return
		fi

		network_get_device device "$iface"
		LOG debug "adjusting route $device: '$IP route $action table $tid $route_line'"
		error=$(mwan3_route_change "$action" "$tid" "$route_line" 2>&1)||
			LOG warn "failed: '$IP route $action table $tid $route_line' - error: $error"
	}
	handle_route_cb(){
		local iface=$1
		mwan3_get_iface_id tid "$1"
		config_get family "$iface" family ipv4
		[ "$family" != "$route_family" ] && return
		[ -z "$route_tid" ] || [ "$tid" = "$route_tid" ] || return
		handle_route "$iface"
	}

	mwan3_update_dev_to_table
	mwan3_route_line_dev "route_tid" "$route_line" "$route_family"

	if [ -n "$route_tid" ] ||
	   { [ -n "${route_line##default*}" ] && [ -n "${route_line##fe80::/64*}" ]; }; then
		config_foreach handle_route_cb interface
	fi
}

# The init/hotplug procd lock also serializes monitor writers with teardown.
# A queued event from an old service incarnation cannot publish into a new one.
mwan3_rtmon_update()
(
	initscript=/etc/init.d/mwan3
	. /lib/functions/procd.sh
	procd_lock
	[ "$(cat "$MWAN3_STATUS_DIR/owned" 2>/dev/null)" = "$owner" ] || exit 0
	if [ "$1" = initial ]; then
		mwan3_set_connected_${family}
		mwan3_add_all_routes "$family"
	else
		mwan3_rtmon_route_handle "$2" "$family"
	fi
)

# A printed PID precedes socket subscription. Establish readiness from the
# monitor's actual netlink socket before copying routes, while events queue.
mwan3_wait_route_monitor()
{
	local pid="$1" group="$2" attempt=0 fd inode subscribed

	while [ "$attempt" -lt 5 ]; do
		kill -0 "$pid" 2>/dev/null || return 1
		for fd in /proc/"$pid"/fd/*; do
			inode=$(readlink "$fd") || continue
			case "$inode" in socket:\[*\]) inode=${inode#socket:[}; inode=${inode%]} ;; *) continue ;; esac
			subscribed=$(awk -v inode="$inode" '$2 == 0 && $NF == inode {print $4}' /proc/net/netlink)
			[ -n "$subscribed" ] && [ "$((0x$subscribed & group))" -ne 0 ] && return 0
		done
		attempt=$((attempt+1))
		sleep 1
	done
	LOG err "Route monitor did not subscribe before its initial dump"
	return 1
}

main()
{
	local IP family owner group

	mwan3_init
	owner=$(cat "$MWAN3_STATUS_DIR/owned") || return 1
	[ -n "$owner" ] || return 1
	family=${1:-ipv4}
	if [ "$family" = ipv6 ]; then
		[ "$NO_IPV6" = 0 ] || return 1
		IP="$IP6"
		group=0x400
	else
		IP="$IP4"
		group=0x40
	fi
	# Wait for the monitor subscription before the initial dump; route events
	# queue in its pipe while copies are installed under the same owner lock.
	sh -c "echo \$\$; exec $IP monitor route" | {
		read -r monitor_pid
		trap_with_arg func_trap "$monitor_pid" SIGINT SIGTERM
		mwan3_wait_route_monitor "$monitor_pid" "$group" || {
			kill "$monitor_pid" 2>/dev/null
			exit 1
		}
		mwan3_rtmon_update initial
		while IFS='' read -r line; do
			[ -z "${line##*table*}" ] && continue
			LOG debug "handling route update $family '$line'"
			mwan3_rtmon_update event "$line"
		done
	} &
	child=$!
	trap_with_arg func_trap "$child" SIGINT SIGTERM
	wait "$child"
}
main "$@"
