From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] recover forwarding with a permitted private external address

An interface lookup failure disables port forwarding. Permit it again after
the interface returns with a private address explicitly allowed by policy,
while retaining rejection of a forbidden private address.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
--- a/miniupnpd.c
+++ b/miniupnpd.c
@@ -1205,8 +1205,8 @@
 				syslog(LOG_INFO, "Public IP address is required by UPnP/PCP/PMP protocols and clients do not work without it");
 				disable_port_forwarding = 1;
 			}
-		} else if (disable_port_forwarding && !reserved) {
-			syslog(LOG_INFO, "Public IP address %s on ext interface %s: Port forwarding is enabled", if_addr, ext_if_name);
+		} else if (disable_port_forwarding && (!reserved || GETFLAG(ALLOWPRIVATEIPV4MASK))) {
+			syslog(LOG_INFO, "External IP address %s on ext interface %s: Port forwarding is enabled", if_addr, ext_if_name);
 			disable_port_forwarding = 0;
 		}
 	}
