 static uint32_t rule_list_redirect_validate = RULE_CACHE_INVALID;
 static uint32_t rule_list_peer_validate = RULE_CACHE_INVALID;
 
+
+/* fw4 publishes this interval set in the same transaction as trigger rules.
+ * Hold its lock through allocation/renewal, using one snapshot for all alternate
+ * port candidates. Nested redirect helpers reuse the outer transaction.
+ */
+static unsigned int mapping_depth;
+static int mapping_lock = -1;
+static unsigned char trigger_reserved[2][65536 / 8];
+
+static int
+reservation_elem_cb(struct nftnl_set_elem *elem, void *data)
+{
+	const char *ifname = data;
+	const unsigned char *key, *end;
+	uint32_t len, endlen;
+	unsigned int first, last, port, protocol;
+
+	key = nftnl_set_elem_get(elem, NFTNL_SET_ELEM_KEY, &len);
+	if (!key || len != IFNAMSIZ + 8 ||
+	    (nftnl_set_elem_is_set(elem, NFTNL_SET_ELEM_FLAGS) &&
+	     (nftnl_set_elem_get_u32(elem, NFTNL_SET_ELEM_FLAGS) & NFT_SET_ELEM_INTERVAL_END))) {
+		errno = EPROTO;
+		return -1;
+	}
+	end = nftnl_set_elem_get(elem, NFTNL_SET_ELEM_KEY_END, &endlen);
+	if (!end) {
+		end = key;
+		endlen = len;
+	}
+	if (endlen != len || memcmp(key, end, IFNAMSIZ + 4)) {
+		errno = EPROTO;
+		return -1;
+	}
+	if (strncmp((const char *)key, ifname, IFNAMSIZ) != 0)
+		return 0;
+	if (key[IFNAMSIZ] == IPPROTO_TCP)
+		protocol = 0;
+	else if (key[IFNAMSIZ] == IPPROTO_UDP)
+		protocol = 1;
+	else {
+		errno = EPROTO;
+		return -1;
+	}
+	first = (key[IFNAMSIZ + 4] << 8) | key[IFNAMSIZ + 5];
+	last = (end[IFNAMSIZ + 4] << 8) | end[IFNAMSIZ + 5];
+	if (last < first) {
+		errno = EPROTO;
+		return -1;
+	}
+	for (port = first; port <= last; port++)
+		trigger_reserved[protocol][port / 8] |= 1U << (port % 8);
+	return 0;
+}
+
+struct reservation_snapshot {
+	const char *ifname;
+	int complete;
+	int missing;
+};
+
+static int
+reservation_done_cb(const struct nlmsghdr *nlh, void *data)
+{
+	struct reservation_snapshot *snapshot = data;
+	int status;
+
+	if (mnl_nlmsg_get_payload_len(nlh) < sizeof(status)) {
+		errno = EPROTO;
+		return MNL_CB_ERROR;
+	}
+	memcpy(&status, mnl_nlmsg_get_payload(nlh), sizeof(status));
+	if (status) {
+		errno = status < 0 ? -status : EPROTO;
+		return MNL_CB_ERROR;
+	}
+	snapshot->complete = 1;
+	return MNL_CB_STOP;
+}
+
+static int
+reservation_error_cb(const struct nlmsghdr *nlh, void *data)
+{
+	struct reservation_snapshot *snapshot = data;
+	const struct nlmsgerr *error;
+
+	if (mnl_nlmsg_get_payload_len(nlh) < sizeof(*error)) {
+		errno = EPROTO;
+		return MNL_CB_ERROR;
+	}
+	error = mnl_nlmsg_get_payload(nlh);
+	if (!error->error)
+		return MNL_CB_OK;
+	snapshot->missing = error->error == -ENOENT;
+	errno = error->error < 0 ? -error->error : EPROTO;
+	return MNL_CB_ERROR;
+}
+
+static int
+reservation_dump_cb(const struct nlmsghdr *nlh, void *data)
+{
+	struct nftnl_set *set = nftnl_set_alloc();
+	int ret;
+
+	if (!set)
+		return MNL_CB_ERROR;
+	ret = nftnl_set_elems_nlmsg_parse(nlh, set);
+	if (ret >= 0)
+		ret = nftnl_set_elem_foreach(set, reservation_elem_cb,
+					   (void *)((struct reservation_snapshot *)data)->ifname);
+	nftnl_set_free(set);
+	return ret < 0 ? MNL_CB_ERROR : MNL_CB_OK;
+}
+
+static int
+snapshot_trigger_reservations(const char *ifname)
+{
+	struct mnl_socket *sock;
+	struct nftnl_set *set;
+	struct nlmsghdr *nlh;
+	char buf[MNL_SOCKET_BUFFER_SIZE];
+	uint32_t seq = 1, portid;
+	int ret = -1, saved_errno;
+	struct reservation_snapshot snapshot = { .ifname = ifname };
+	mnl_cb_t control[NLMSG_MIN_TYPE] = {
+		[NLMSG_DONE] = reservation_done_cb,
+		[NLMSG_ERROR] = reservation_error_cb
+	};
+
+	memset(trigger_reserved, 0, sizeof(trigger_reserved));
+	if (!ifname || !*ifname) {
+		errno = EINVAL;
+		return -1;
+	}
+	sock = mnl_socket_open(NETLINK_NETFILTER);
+	if (!sock)
+		return -1;
+	if (mnl_socket_bind(sock, 0, MNL_SOCKET_AUTOPID) < 0)
+		goto out;
+	portid = mnl_socket_get_portid(sock);
+	set = nftnl_set_alloc();
+	if (!set)
+		goto out;
+	nftnl_set_set_str(set, NFTNL_SET_TABLE, "fw4");
+	nftnl_set_set_str(set, NFTNL_SET_NAME, "port_trigger_ports");
+	nlh = nftnl_nlmsg_build_hdr(buf, NFT_MSG_GETSETELEM, NFPROTO_INET,
+				    NLM_F_DUMP, seq);
+	nftnl_set_elems_nlmsg_build_payload(nlh, set);
+	nftnl_set_free(set);
+	if (mnl_socket_sendto(sock, nlh, nlh->nlmsg_len) < 0)
+		goto out;
+	do {
+		ret = mnl_socket_recvfrom(sock, buf, sizeof(buf));
+		if (ret <= 0) {
+			if (!ret) errno = EIO;
+			ret = -1;
+			break;
+		}
+		ret = mnl_cb_run2(buf, ret, seq, portid, reservation_dump_cb,
+				  &snapshot, control, NLMSG_MIN_TYPE);
+	} while (ret > 0);
+	/* A missing set is the defined compatibility case for ordinary fw4. */
+	if (ret < 0 && snapshot.missing) {
+		memset(trigger_reserved, 0, sizeof(trigger_reserved));
+		ret = 0;
+	} else if (!ret && !snapshot.complete) {
+		errno = EPROTO;
+		ret = -1;
+	}
+out:
+	saved_errno = errno;
+	mnl_socket_close(sock);
+	errno = saved_errno;
+	return ret;
+}
+
+int
+port_mapping_begin(const char *ifname, int wait)
+{
+	if (mapping_depth) {
+		mapping_depth++;
+		return 0;
+	}
+	mapping_lock = open("/var/run/fw4.lock", O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+	if (mapping_lock < 0)
+		return -1;
+	if (flock(mapping_lock, LOCK_EX | (wait ? 0 : LOCK_NB)) < 0 || snapshot_trigger_reservations(ifname) < 0) {
+		int saved_errno = errno;
+		close(mapping_lock);
+		mapping_lock = -1;
+		errno = saved_errno;
+		syslog(LOG_ERR, "Cannot read fw4 port reservations: %m");
+		return -1;
+	}
+	mapping_depth = 1;
+	/* A previous full fw4 reload may have withdrawn every daemon rule. */
+	rule_list_redirect_validate = RULE_CACHE_INVALID;
+	rule_list_filter_validate = RULE_CACHE_INVALID;
+	rule_list_peer_validate = RULE_CACHE_INVALID;
+	return 0;
+}
+
+void
+port_mapping_end(void)
+{
+	if (mapping_depth && --mapping_depth == 0) {
+		close(mapping_lock);
+		mapping_lock = -1;
+	}
+}
+
+int
+port_mapping_reserved(unsigned short port, int proto)
+{
+	if (!mapping_depth)
+		return -1;
+	if (proto != IPPROTO_TCP && proto != IPPROTO_UDP)
+		return 0;
+	return !!(trigger_reserved[proto == IPPROTO_UDP][port / 8] & (1U << (port % 8)));
+}
 
