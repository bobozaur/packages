+upnp_redirect(const char * rhost, unsigned short eport,
+              const char * iaddr, unsigned short iport,
+              const char * protocol, const char * desc,
+              unsigned int leaseduration)
+{
+	int result;
+	if (port_mapping_begin(ext_if_name, 0) < 0)
+		return -1;
+	result = port_mapping_reserved(eport, proto_atoi(protocol));
+	if (!result)
+		result = upnp_redirect_locked(rhost, eport, iaddr, iport, protocol, desc, leaseduration);
+	else
+		result = result > 0 ? -4 : -1;
+	port_mapping_end();
+	return result;
+}
