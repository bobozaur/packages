+	int result;
+	if (port_mapping_begin(ext_if_name, 0) < 0)
+		return PCP_ERR_NO_RESOURCES;
+	result = CreatePCPMap_NAT_locked(pcp_msg_info);
+	port_mapping_end();
+	return result;
 }
 
