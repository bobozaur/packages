+int reload_from_lease_file(void)
+{
+	int result;
+	if (!lease_file)
+		return -1;
+	/* Startup precedes the request loop. Wait before unlinking the input so
+	 * an ordinary concurrent firewall reload cannot discard saved leases.
+	 */
+	if (port_mapping_begin(ext_if_name, 1) < 0)
+		return -1;
+	result = reload_from_lease_file_locked();
+	port_mapping_end();
+	return result;
