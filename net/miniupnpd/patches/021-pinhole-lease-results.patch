+lease_file6_add(const char *rem_client, unsigned short rem_port,
+	const char *int_client, unsigned short int_port, int proto, int uid,
+	const char *desc, unsigned int expiry)
+{
+	char record[512];
+	unsigned int timestamp = expiry ? time(NULL) + expiry - upnp_time() : 0;
+	int len = snprintf(record, sizeof(record), "%s;%s;%hu;%s;%hu;%u;%u;%s\n",
+		proto_itoa(proto), int_client, int_port, rem_client ? rem_client : "",
+		rem_port, uid, timestamp, desc ? desc : "");
+	if (len < 0 || (unsigned int)len >= sizeof(record))
+		return -1;
+	return lease_file6_rewrite(uid, record, 0);
