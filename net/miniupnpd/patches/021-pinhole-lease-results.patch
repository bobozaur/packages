+lease_file6_rewrite(int uid, const char *record, unsigned int timestamp)
+{
+	FILE *fd, *fdt;
+	int tmp, failed = 0, found = 0;
+	char line[512], tmpfilename[128];
+	if (!lease_file6)
+		return 0;
+	if (uid < 0 || strlen(lease_file6) + 7 > sizeof(tmpfilename))
+		return -1;
+	fd = fopen(lease_file6, "r");
+	if (!fd && errno != ENOENT)
+		return -1;
+	if (!fd && !record)
+		return 0;
+	snprintf(tmpfilename, sizeof(tmpfilename), "%sXXXXXX", lease_file6);
+	tmp = mkstemp(tmpfilename);
+	if (tmp < 0) {
+		if (fd) fclose(fd);
+		return -1;
+	}
+	fchmod(tmp, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
+	fdt = fdopen(tmp, "w");
+	if (!fdt) {
+		close(tmp);
+		if (fd) fclose(fd);
+		remove(tmpfilename);
+		return -1;
+	}
+	while (fd && fgets(line, sizeof(line), fd)) {
+		char *field = line, *end;
+		unsigned long row_uid;
+		int i;
+		for (i = 0; i < 5 && field; i++) {
+			field = strchr(field, ';');
+			if (field) field++;
+		}
+		if (field) {
+			row_uid = strtoul(field, &end, 10);
+			if (end != field && *end == ';' && row_uid == (unsigned int)uid) {
+				if (record) {
+					if (!found && fputs(record, fdt) == EOF) failed = 1;
+				} else if (timestamp) {
+					char *suffix = strchr(++end, ';');
+					size_t prefix = end - line;
+					if (!suffix || fwrite(line, 1, prefix, fdt) != prefix ||
+					    fprintf(fdt, "%u%s", timestamp, suffix) < 0) failed = 1;
+				}
+				found = 1;
+				if (failed) break;
+				continue;
+			}
+		}
+		if (fputs(line, fdt) == EOF) {
+			failed = 1;
+			break;
+		}
+	}
+	if (record && !found && fputs(record, fdt) == EOF) failed = 1;
+	if (fd) {
+		failed |= ferror(fd);
+		if (fclose(fd)) failed = 1;
+	}
+	if (fclose(fdt)) failed = 1;
+	if (!failed && rename(tmpfilename, lease_file6) == 0)
+		return 0;
+	remove(tmpfilename);
+	return -1;
 }
 
