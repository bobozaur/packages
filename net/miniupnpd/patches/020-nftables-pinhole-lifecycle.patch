+/* Reconstruct allocation from the kernel, including surviving rules after a
+ * daemon restart. The bounded bitmap also prevents collisions after UID wrap. */
+static int allocate_uid(void)
+{
+	unsigned char used[8192] = {0};
+	rule_t *p;
+	int uid;
+	unsigned int timestamp;
+	if (refresh_nft_cache_filter_fresh() < 0)
+		return -1;
+	LIST_FOREACH(p, &head_filter, entry) {
+		if (p->type == RULE_FILTER && p->desc_len &&
+		    sscanf(p->desc, PINEHOLE_LABEL_FORMAT_SKIPDESC, &uid, &timestamp) == 2 &&
+		    uid > 0 && uid < 65535)
+			used[uid / 8] |= 1U << (uid % 8);
+	}
+	uid = next_uid;
+	do {
+		if (!(used[uid / 8] & (1U << (uid % 8))))
+			return uid;
+		if (++uid >= 65535)
+			uid = 1;
+	} while (uid != next_uid);
+	return -1;
+}
