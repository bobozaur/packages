From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] pingcheck: validate bounded probe records and separate interface aliases

Validate each complete UCI record before publication, reject duplicate probe
keys and excess records, and add family, ordered logical-interface aliases and
optional default-route policy. Preserve IPv4 and name-as-interface defaults.
The following state patch resolves those aliases against native netifd state.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>

--- a/main.c
+++ b/main.c
@@ -180,7 +180,8 @@
 	}
 
 	ret = uci_config_pingcheck(intf, MAX_NUM_INTERFACES);
-	if (!ret) {
+	if (ret < 0) {
+		ret = 0;
 		LOG_CRIT("Could not read UCI config");
 		goto exit;
 	}
--- a/main.h
+++ b/main.h
@@ -56,7 +56,9 @@
 	int conf_timeout;
 	char conf_hostname[MAX_HOSTNAME_LEN];
 	struct sockaddr_storage conf_host;
+	char conf_interfaces[MAX_IFNAME_LEN];
 	int conf_family;
+	bool conf_require_default;
 	enum protocol conf_proto;
 	int conf_tcp_port;
 	int conf_panic_timeout; /* minutes */
--- a/uci.c
+++ b/uci.c
@@ -21,140 +21,99 @@
 #include <string.h>
 #include <uci.h>
 
-/** analogous to uci_lookup_option_string from uci.h, returns -1 when not found
- */
-static int uci_lookup_option_int(struct uci_context* uci, struct uci_section* s,
-								 const char* name)
+static const char* value(struct uci_context* ctx, struct uci_section* section,
+						 struct uci_section* defaults, const char* name)
 {
-	const char* str = uci_lookup_option_string(uci, s, name);
-	return str == NULL ? -1 : atoi(str);
+	const char* result = uci_lookup_option_string(ctx, section, name);
+	return result ? result : defaults ? uci_lookup_option_string(ctx, defaults, name) : NULL;
+}
+
+static int number(struct uci_context* ctx, struct uci_section* section,
+				  struct uci_section* defaults, const char* name, int fallback)
+{
+	const char* str = value(ctx, section, defaults, name);
+	if (!str)
+		return fallback;
+	char* end;
+	long result = strtol(str, &end, 10);
+	return *end || result < 0 || result > 86400 ? -1 : result;
 }
 
