+		item.conf_family = family && !strcmp(family, "ipv6") ? AF_INET6 : AF_INET;
+		item.conf_proto = protocol && !strcmp(protocol, "tcp") ? TCP : ICMP;
+		item.conf_interval = number(ctx, section, defaults, "interval", 10);
+		item.conf_timeout = number(ctx, section, defaults, "timeout", 30);
+		item.conf_tcp_port = number(ctx, section, defaults, "tcp_port", 80);
+		item.conf_panic_timeout = number(ctx, section, defaults, "panic", 0);
+		item.conf_ignore_ubus = ignore_ubus > 0;
+		item.conf_require_default = require_default > 0;
+		if (!name || !*name || strlen(name) >= sizeof(item.name) ||
+			!owners || !*owners || strlen(owners) >= sizeof(item.conf_interfaces) ||
+			!host || !*host || strlen(host) >= sizeof(item.conf_hostname) ||
+			(family && strcmp(family, "ipv4") && strcmp(family, "ipv6")) ||
+			(protocol && strcmp(protocol, "icmp") && strcmp(protocol, "tcp")) ||
+			item.conf_interval < 1 || item.conf_timeout < item.conf_interval ||
+			item.conf_tcp_port < 1 || item.conf_tcp_port > 65535 ||
+			item.conf_panic_timeout < 0 || item.conf_panic_timeout > 1440 ||
+			(item.conf_ignore_ubus && (item.conf_require_default || strpbrk(owners, " \t\n"))) || count >= len) {
+			LOG_ERR("Invalid or excessive pingcheck probe configuration");
+			count = -1;
+			break;
+		}
+		bool duplicate = false;
+		for (int i = 0; i < count; i++)
+			duplicate |= !strcmp(intf[i].name, name);
+		if (duplicate) {
+			LOG_ERR("Duplicate pingcheck probe name '%s'", name);
+			count = -1;
+			break;
+		}
+		strcpy(item.name, name);
+		strcpy(item.conf_interfaces, owners);
+		strcpy(item.conf_hostname, host);
+		intf[count++] = item;
 	}
-
-	uci_foreach_element(&p->sections, e)
-	{
