+		int require_default = number(ctx, section, defaults, "require_default", 0);
+		if (disabled < 0 || ignore_ubus < 0 || require_default < 0) {
+			LOG_ERR("Invalid pingcheck boolean configuration");
+			count = -1;
+			break;
+		}
+		if (disabled)
+			continue;
+		const char* name = uci_lookup_option_string(ctx, section, "name");
+		const char* owners = value(ctx, section, defaults, "interface");
+		const char* host = value(ctx, section, defaults, "host");
+		const char* family = value(ctx, section, defaults, "family");
+		const char* protocol = value(ctx, section, defaults, "protocol");
+		if (!owners)
