-static void ubus_result_cb(__attribute__((unused)) struct ubus_request* req,
-						   __attribute__((unused)) int type,
-						   struct blob_attr* msg)
-{
-	if (!msg) {
+/* The reply belongs to this invocation, including nested event delivery. */
+static void ubus_result_cb(struct ubus_request* req, int type, struct blob_attr* msg)
+{
+	struct blob_attr** result = req->priv;
+	(void)type;
+	free(*result);
+	*result = msg ? blob_memdup(msg) : NULL;
+}
+
+enum { IF_NAME, IF_UP, IF_PENDING, IF_DEVICE, IF_L3DEVICE, IF_ROUTE, __IF_MAX };
+static const struct blobmsg_policy if_policy[] = {
+	[IF_NAME] = { .name = "interface", .type = BLOBMSG_TYPE_STRING },
+	[IF_UP] = { .name = "up", .type = BLOBMSG_TYPE_BOOL },
+	[IF_PENDING] = { .name = "pending", .type = BLOBMSG_TYPE_BOOL },
+	[IF_DEVICE] = { .name = "device", .type = BLOBMSG_TYPE_STRING },
+	[IF_L3DEVICE] = { .name = "l3_device", .type = BLOBMSG_TYPE_STRING },
+	[IF_ROUTE] = { .name = "route", .type = BLOBMSG_TYPE_ARRAY },
+};
+enum { ROUTE_TARGET, ROUTE_MASK, ROUTE_TYPE, __ROUTE_MAX };
+static const struct blobmsg_policy route_policy[] = {
+	[ROUTE_TARGET] = { .name = "target", .type = BLOBMSG_TYPE_STRING },
+	[ROUTE_MASK] = { .name = "mask", .type = BLOBMSG_TYPE_INT32 },
+	[ROUTE_TYPE] = { .name = "type", .type = BLOBMSG_TYPE_INT32 },
+};
+
+static bool default_route(struct blob_attr* routes, int family)
+{
+	struct blob_attr* attr;
+	int remaining;
+	if (!routes)
+		return false;
+	blobmsg_for_each_attr(attr, routes, remaining) {
+		struct blob_attr* tb[__ROUTE_MAX];
+		blobmsg_parse(route_policy, __ROUTE_MAX, tb,
+					  blobmsg_data(attr), blobmsg_data_len(attr));
+		if (!tb[ROUTE_TARGET] || !tb[ROUTE_MASK] || blobmsg_get_u32(tb[ROUTE_MASK]))
+			continue;
+		if (tb[ROUTE_TYPE] && blobmsg_get_u32(tb[ROUTE_TYPE]) != 1)
+			continue;
+		const char* target = blobmsg_get_string(tb[ROUTE_TARGET]);
+		if (!strcmp(target, family == AF_INET6 ? "::" : "0.0.0.0"))
+			return true;
+	}
+	return false;
+}
+
+/* A successful dump establishes both presence and absence. Candidate names
+ * are explicit ordered aliases; independent uplinks use independent probes. */
+int ubus_interface_get_status(struct ping_intf* pi, char* device, char* interface)
+{
+	struct blob_attr* reply = NULL;
+	uint32_t id;
+	int result = -1;
+	bool pending = false;
+	if (ubus_lookup_id(ctx, "network.interface", &id) ||
+		ubus_invoke(ctx, id, "dump", NULL, ubus_result_cb, &reply, UBUS_TIMEOUT) ||
+		!reply)
+		goto out;
+	const struct blobmsg_policy policy = { .name = "interface", .type = BLOBMSG_TYPE_ARRAY };
+	struct blob_attr* entries;
+	blobmsg_parse(&policy, 1, &entries, blob_data(reply), blob_len(reply));
+	if (!entries)
+		goto out;
+	result = 0;
+	char names[MAX_IFNAME_LEN], *save, *name;
+	strcpy(names, pi->conf_interfaces);
+	for (name = strtok_r(names, " \t\n", &save); name;
+		 name = strtok_r(NULL, " \t\n", &save)) {
+		struct blob_attr* entry;
+		int remaining;
+		blobmsg_for_each_attr(entry, entries, remaining) {
+			struct blob_attr* tb[__IF_MAX];
+			blobmsg_parse(if_policy, __IF_MAX, tb,
+						  blobmsg_data(entry), blobmsg_data_len(entry));
+			if (!tb[IF_NAME] || strcmp(blobmsg_get_string(tb[IF_NAME]), name))
+				continue;
+			pending |= tb[IF_PENDING] && blobmsg_get_bool(tb[IF_PENDING]);
+			if (!tb[IF_UP] || !blobmsg_get_bool(tb[IF_UP]))
+				continue;
+			struct blob_attr* dev = tb[IF_L3DEVICE] ? tb[IF_L3DEVICE] : tb[IF_DEVICE];
+			if (!dev || strlen(blobmsg_get_string(dev)) >= MAX_IFNAME_LEN)
+				continue;
+			bool route = default_route(tb[IF_ROUTE], pi->conf_family);
+			result = 1;
+			if (!route && pi->conf_require_default)
+				continue;
+			strcpy(device, blobmsg_get_string(dev));
+			strcpy(interface, name);
+			result = route ? 2 : 1;
+			goto out;
+		}
+	}
+	if (pending)
+		result = -1;
+out:
+	free(reply);
+	return result;
+}
