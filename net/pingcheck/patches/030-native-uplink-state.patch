+void ping_refresh(struct ping_intf* pi)
+{
+	char device[MAX_IFNAME_LEN] = {0}, interface[MAX_IFNAME_LEN] = {0};
+	int status;
+	unsigned int generation = network_generation();
+	if (pi->conf_ignore_ubus) {
+		snprintf(device, sizeof(device), "%s", pi->conf_interfaces);
+		snprintf(interface, sizeof(interface), "%s", pi->conf_interfaces);
+		status = 2;
+	} else {
+		status = ubus_interface_get_status(pi, device, interface);
+	}
+	if (generation != network_generation())
+		return;
+	if (status < 2 && (status != 1 || pi->conf_require_default)) {
+		ping_stop(pi);
+		state_change(status < 0 ? UNKNOWN : status == 0 ? DOWN :
+					 UP_WITHOUT_DEFAULT_ROUTE, pi);
+		return;
+	}
+	if (pi->active && !strcmp(device, pi->device) &&
+		!strcmp(interface, pi->interface))
+		return;
+	ping_stop(pi);
+	memcpy(pi->device, device, sizeof(device));
+	memcpy(pi->interface, interface, sizeof(interface));
+	if (!ping_init(pi))
+		state_change(UNKNOWN, pi);
+}
