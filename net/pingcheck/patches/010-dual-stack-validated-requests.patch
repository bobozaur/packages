+	socklen_t src_len = sizeof(src);
+	ssize_t len = recvfrom(pi->ufd.fd, data, sizeof(data), 0,
+						   (struct sockaddr*)&src, &src_len);
+	bool v6 = pi->conf_family == AF_INET6;
+	size_t offset = 0;
+	if (len < 0 || !pi->awaiting_reply || src.ss_family != pi->conf_family)
+		return false;
+	if (v6) {
+		if (memcmp(&((struct sockaddr_in6*)&src)->sin6_addr,
+				   &((struct sockaddr_in6*)&pi->conf_host)->sin6_addr,
+				   sizeof(struct in6_addr)))
+			return false;
+	} else {
+		if (len < 20 || data[0] >> 4 != 4 ||
+			((struct sockaddr_in*)&src)->sin_addr.s_addr !=
