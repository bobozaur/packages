Subject: [PATCH] libav: read channel count from the new channel layout API

libavcodec 59.24.100 added AVCodecParameters.ch_layout and deprecated the
channels member, which newer FFmpeg releases no longer provide. Use the
channel layout's count with that API while retaining compatibility with
older libavcodec versions.

All FFmpeg channel-count consumers use lav_channels(), including AAC
profile selection and the stored audio metadata.

--- a/libav.h
+++ b/libav.h
@@ -174,7 +174,11 @@ lav_get_interlaced(AVStream *s)
 #define lav_codec_tag(s) s->codecpar->codec_tag
 #define lav_sample_rate(s) s->codecpar->sample_rate
 #define lav_bit_rate(s) s->codecpar->bit_rate
+#if LIBAVCODEC_VERSION_INT >= ((59<<16)+(24<<8)+100)
+#define lav_channels(s) s->codecpar->ch_layout.nb_channels
+#else
 #define lav_channels(s) s->codecpar->channels
+#endif
 #define lav_width(s) s->codecpar->width
 #define lav_height(s) s->codecpar->height
 #define lav_profile(s) s->codecpar->profile
